{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Hephaisto chart values",
  "description": "Structural guards for the values whose failure mode is silence rather than an error.",
  "type": "object",
  "required": [
    "image",
    "mode",
    "observabilityNamespace",
    "prometheusOperator",
    "policy",
    "secrets",
    "networkPolicy"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Empty means .Chart.AppVersion, which CI stamps from the git tag. An OCI tag can never contain '+'.",
          "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "description": "The env arm of the kill switch. The ConfigMap and database arms are the other two, and the most restrictive wins.",
      "enum": [
        "Off",
        "Observe",
        "DryRun",
        "Auto"
      ]
    },
    "observabilityNamespace": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "description": "AGPL section 13. Empty means upstream; set it to your own source if you run a modified build others can reach.",
      "type": "string"
    },
    "prometheusOperator": {
      "type": "object",
      "required": [
        "selectorLabels"
      ],
      "properties": {
        "selectorLabels": {
          "description": "Must match your Prometheus's podMonitorSelector and ruleSelector. Required and non-empty because the failure mode of getting it wrong is total silence: every object is created, nothing is ever selected, and the agent reports itself healthy.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "actionableNamespaces"
      ],
      "properties": {
        "actionableNamespaces": {
          "description": "Namespaces the agent may act in. Empty means nowhere. kube-*, default, the release namespace and observabilityNamespace are refused at render time. Each must also carry the label hephaisto.dev/destructive-actions-allowed=true, which the policy engine checks.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "autoEnabledActionTypes": {
          "description": "Action types that may execute without a human, and only in Auto mode. Empty means everything waits for approval. Promote one type at a time.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "RestartPod",
              "RolloutRestart",
              "RollbackDeployment",
              "ScaleWorkload",
              "DeleteStuckJob",
              "DeleteFailedJobPods",
              "SilenceAlert",
              "PatchResources",
              "CordonNode",
              "DrainNode"
            ]
          }
        },
        "rollbackFreshRevisionWindow": {
          "type": "string",
          "description": "A revision younger than this counts as a fresh deploy, so rolling back is admissible. .NET TimeSpan (hh:mm:ss), not Go duration. Widening this is the dangerous direction.",
          "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$"
        },
        "rollbackPreviousHealthyMinimum": {
          "type": "string",
          "description": "How long the previous revision must have been healthy before the agent may roll back onto it unattended. .NET TimeSpan (hh:mm:ss), not Go duration.",
          "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$"
        },
        "clusterUnhealthyCeiling": {
          "type": "number",
          "description": "Above this fraction of unhealthy pods everything escalates as a cluster-wide event. The e2e --full gate crosses this deliberately; the fix for that is a separate acting run, not a wider ceiling.",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "required": [
        "postgres",
        "llm"
      ],
      "description": "Names of Secrets you create. This chart has no Secret template and will not grow one.",
      "properties": {
        "postgres": {
          "type": "string",
          "minLength": 1
        },
        "llm": {
          "type": "string",
          "minLength": 1
        },
        "grafanaMcp": {
          "type": "string"
        },
        "grafanaAnnotation": {
          "type": "string"
        },
        "notificationWebhook": {
          "type": "string"
        },
        "notificationTeams": {
          "type": "string"
        },
        "auth": {
          "type": "string",
          "description": "Secret holding the OIDC client secret under key `clientSecret`. Required when auth.enabled is true."
        }
      },
      "additionalProperties": false
    },
    "grafanaMcp": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "datasourceUids": {
          "type": "object",
          "description": "Datasource name -> uid, put into the environment card so the agent does not spend a tool call discovering them. Free-form: the names are yours.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "alertmanager": {
      "type": "object",
      "description": "Write-only, and the only thing written is a silence. Alerts arrive by webhook.",
      "properties": {
        "url": {
          "type": "string"
        },
        "maxDuration": {
          "type": "string",
          "description": ".NET TimeSpan (hh:mm:ss), not Go duration. \"2h\" does not parse and the agent would fail to start.",
          "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$"
        }
      },
      "additionalProperties": false
    },
    "notifications": {
      "type": "object",
      "description": "Outbound delivery. Nothing is on until routes is non-empty AND a channel is configured.",
      "properties": {
        "baseUrl": {
          "type": "string",
          "description": "The externally reachable URL of this Hephaisto. Required once any route exists; the pod cannot discover it."
        },
        "grafanaUrl": {
          "type": "string"
        },
        "webhook": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "signed": {
              "type": "boolean"
            }
          }
        },
        "teams": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "channel",
              "events"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "enum": [
                  "webhook",
                  "teams"
                ],
                "description": "Must name a configured channel, or startup validation refuses it."
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "IncidentEscalated",
                    "ApprovalRequired",
                    "IncidentResolved",
                    "VerificationFailed",
                    "ModeChanged",
                    "PolicyChanged"
                  ]
                }
              },
              "minSeverity": {
                "type": "string",
                "enum": [
                  "Info",
                  "Warning",
                  "Critical"
                ]
              },
              "namespaces": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "postgres": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "embedded": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "storage": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "appUser": {
          "type": "string",
          "description": "The non-owner role the agent serves as. Must not be the owner named by secrets.postgres: Postgres cannot restrain a table's owner, so pointing this at the owner enforces nothing and the agent refuses to start."
        }
      },
      "additionalProperties": false
    },
    "otel": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "http/protobuf",
            "grpc"
          ]
        },
        "environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "properties": {
        "kubernetes": {
          "type": "boolean"
        },
        "slo": {
          "type": "boolean"
        },
        "noTraffic": {
          "type": "boolean"
        },
        "watchdog": {
          "type": "boolean"
        },
        "observabilitySelfcheck": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sidecarLabel": {
          "type": "string",
          "minLength": 1
        },
        "folder": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "extraIngressCIDRs": {
          "description": "Every entry here can forge an alert to an unauthenticated, incident-creating endpoint.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
          }
        },
        "egress": {
          "type": "object",
          "description": "OFF by default. Enabling this denies everything not listed, including DNS and the API server.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dns": {
              "type": "boolean"
            },
            "apiServerCIDRs": {
              "description": "The API server is an endpoint, not a selectable pod. Without this the agent cannot watch, read events or act.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
              }
            },
            "apiServerPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "extraEgressCIDRs": {
              "description": "The LLM API and the notification endpoints. Empty means no escalation can reach a person.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
              }
            },
            "extraEgressPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "nodeRole": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "readOnlyRootFilesystem": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array",
      "description": "Extra env vars, appended last. Reserved names are refused in _helpers.tpl.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "description": "Extra envFrom sources (configMapRef / secretRef).",
      "items": {
        "type": "object"
      }
    },
    "grafana": {
      "type": "object",
      "description": "Grafana's own HTTP API, for incident annotations. Separate from grafanaMcp: that is the MCP server the model queries THROUGH, this is the API the agent writes to.",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Empty disables annotation entirely."
        }
      }
    },
    "webhookPort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Port for /webhooks. 0 keeps everything on 8080. When set, the console and API answer only on 8080 and the webhook only here, so a NetworkPolicy can protect the receiver without deciding who may read the console."
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "description": "OIDC for the console and API. Fails closed: if the IdP is unreachable the agent is unavailable.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authority": {
          "type": "string",
          "description": "The OIDC issuer. Required when enabled."
        },
        "clientId": {
          "type": "string"
        },
        "rolesClaim": {
          "type": "string"
        },
        "readerRole": {
          "type": "string",
          "description": "Empty means any authenticated user."
        },
        "approverRole": {
          "type": "string",
          "description": "Empty means any authenticated user may approve a cluster change."
        }
      }
    }
  },
  "additionalProperties": false
}
