{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Hephaisto chart values",
  "description": "Structural guards for the values whose failure mode is silence rather than an error.",
  "type": "object",
  "required": ["image", "mode", "observabilityNamespace", "prometheusOperator", "policy", "secrets", "networkPolicy"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },

    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "description": "Empty means .Chart.AppVersion, which CI stamps from the git tag. An OCI tag can never contain '+'.",
          "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$"
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },

    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },

    "serviceAccount": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },

    "mode": {
      "description": "The env arm of the kill switch. The ConfigMap and database arms are the other two, and the most restrictive wins.",
      "enum": ["Off", "Observe", "DryRun", "Auto"]
    },

    "observabilityNamespace": { "type": "string", "minLength": 1 },

    "sourceUrl": {
      "description": "AGPL section 13. Empty means upstream; set it to your own source if you run a modified build others can reach.",
      "type": "string"
    },

    "prometheusOperator": {
      "type": "object",
      "required": ["selectorLabels"],
      "properties": {
        "selectorLabels": {
          "description": "Must match your Prometheus's podMonitorSelector and ruleSelector. Required and non-empty because the failure mode of getting it wrong is total silence: every object is created, nothing is ever selected, and the agent reports itself healthy.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "policy": {
      "type": "object",
      "required": ["actionableNamespaces"],
      "properties": {
        "actionableNamespaces": {
          "description": "Namespaces the agent may act in. Empty means nowhere. kube-*, default, the release namespace and observabilityNamespace are refused at render time.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },

    "secrets": {
      "type": "object",
      "required": ["postgres", "llm"],
      "description": "Names of Secrets you create. This chart has no Secret template and will not grow one.",
      "properties": {
        "postgres": { "type": "string", "minLength": 1 },
        "llm": { "type": "string", "minLength": 1 },
        "grafanaMcp": { "type": "string" }
      }
    },

    "postgres": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "embedded": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string", "minLength": 1 },
            "storage": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
            "storageClassName": { "type": "string" }
          }
        }
      }
    },

    "otel": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "protocol": { "enum": ["http/protobuf", "grpc"] },
        "environment": { "type": "string" }
      }
    },

    "grafanaMcp": {
      "type": "object",
      "properties": { "url": { "type": "string" } }
    },

    "alerts": {
      "type": "object",
      "properties": {
        "kubernetes": { "type": "boolean" },
        "slo": { "type": "boolean" },
        "watchdog": { "type": "boolean" },
        "observabilitySelfcheck": { "type": "boolean" }
      }
    },

    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "sidecarLabel": { "type": "string", "minLength": 1 },
        "folder": { "type": "string" }
      }
    },

    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "extraIngressCIDRs": {
          "description": "Every entry here can forge an alert to an unauthenticated, incident-creating endpoint.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$" }
        }
      }
    },

    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "nodeRole": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "securityContext": {
      "type": "object",
      "properties": {
        "readOnlyRootFilesystem": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podAnnotations": { "type": "object" }
  }
}
