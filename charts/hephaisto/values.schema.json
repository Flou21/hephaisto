{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Hephaisto chart values",
  "description": "Structural guards for the values whose failure mode is silence rather than an error.",
  "type": "object",
  "required": ["image", "mode", "observabilityNamespace", "prometheusOperator", "policy", "secrets", "networkPolicy"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },

    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "description": "Empty means .Chart.AppVersion, which CI stamps from the git tag. An OCI tag can never contain '+'.",
          "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$"
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },

    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },

    "serviceAccount": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },

    "mode": {
      "description": "The env arm of the kill switch. The ConfigMap and database arms are the other two, and the most restrictive wins.",
      "enum": ["Off", "Observe", "DryRun", "Auto"]
    },

    "observabilityNamespace": { "type": "string", "minLength": 1 },

    "sourceUrl": {
      "description": "AGPL section 13. Empty means upstream; set it to your own source if you run a modified build others can reach.",
      "type": "string"
    },

    "prometheusOperator": {
      "type": "object",
      "required": ["selectorLabels"],
      "properties": {
        "selectorLabels": {
          "description": "Must match your Prometheus's podMonitorSelector and ruleSelector. Required and non-empty because the failure mode of getting it wrong is total silence: every object is created, nothing is ever selected, and the agent reports itself healthy.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "policy": {
      "type": "object",
      "required": ["actionableNamespaces"],
      "properties": {
        "actionableNamespaces": {
          "description": "Namespaces the agent may act in. Empty means nowhere. kube-*, default, the release namespace and observabilityNamespace are refused at render time. Each must also carry the label hephaisto.dev/destructive-actions-allowed=true, which the policy engine checks.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "autoEnabledActionTypes": {
          "description": "Action types that may execute without a human, and only in Auto mode. Empty means everything waits for approval. Promote one type at a time.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "RestartPod",
              "RolloutRestart",
              "RollbackDeployment",
              "ScaleWorkload",
              "DeleteStuckJob",
              "DeleteFailedJobPods",
              "SilenceAlert",
              "PatchResources",
              "CordonNode",
              "DrainNode"
            ]
          }
        }
      }
    },

    "secrets": {
      "type": "object",
      "required": ["postgres", "llm"],
      "description": "Names of Secrets you create. This chart has no Secret template and will not grow one.",
      "properties": {
        "postgres": { "type": "string", "minLength": 1 },
        "llm": { "type": "string", "minLength": 1 },
        "grafanaMcp": { "type": "string" },
        "grafanaAnnotation": { "type": "string" },
        "notificationWebhook": { "type": "string" },
        "notificationTeams": { "type": "string" }
      }
    },

    "grafanaMcp": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "datasourceUids": {
          "type": "object",
          "description": "Datasource name -> uid, injected into the environment card so the agent need not call list_datasources.",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "alertmanager": {
      "type": "object",
      "description": "Write-only, and the only thing written is a silence. Alerts arrive by webhook.",
      "properties": {
        "url": { "type": "string" },
        "maxDuration": {
          "type": "string",
          "description": ".NET TimeSpan (hh:mm:ss), not Go duration. \"2h\" does not parse and the agent would fail to start.",
          "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$"
        }
      }
    },

    "notifications": {
      "type": "object",
      "description": "Outbound delivery. Nothing is on until routes is non-empty AND a channel is configured.",
      "properties": {
        "baseUrl": {
          "type": "string",
          "description": "The externally reachable URL of this Hephaisto. Required once any route exists; the pod cannot discover it."
        },
        "grafanaUrl": { "type": "string" },
        "webhook": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "signed": { "type": "boolean" }
          }
        },
        "teams": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel", "events"],
            "properties": {
              "channel": {
                "type": "string",
                "enum": ["webhook", "teams"],
                "description": "Must name a configured channel, or startup validation refuses it."
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "IncidentEscalated",
                    "ApprovalRequired",
                    "IncidentResolved",
                    "VerificationFailed",
                    "ModeChanged",
                    "PolicyChanged"
                  ]
                }
              },
              "minSeverity": { "type": "string", "enum": ["Info", "Warning", "Critical"] },
              "namespaces": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },

    "postgres": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "embedded": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string", "minLength": 1 },
            "storage": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
            "storageClassName": { "type": "string" }
          }
        }
      }
    },

    "otel": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "protocol": { "enum": ["http/protobuf", "grpc"] },
        "environment": { "type": "string" }
      }
    },

    "grafanaMcp": {
      "type": "object",
      "properties": { "url": { "type": "string" } }
    },

    "alerts": {
      "type": "object",
      "properties": {
        "kubernetes": { "type": "boolean" },
        "slo": { "type": "boolean" },
        "watchdog": { "type": "boolean" },
        "observabilitySelfcheck": { "type": "boolean" }
      }
    },

    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "sidecarLabel": { "type": "string", "minLength": 1 },
        "folder": { "type": "string" }
      }
    },

    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "extraIngressCIDRs": {
          "description": "Every entry here can forge an alert to an unauthenticated, incident-creating endpoint.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$" }
        },
        "egress": {
          "type": "object",
          "description": "OFF by default. Enabling this denies everything not listed, including DNS and the API server.",
          "properties": {
            "enabled": { "type": "boolean" },
            "dns": { "type": "boolean" },
            "apiServerCIDRs": {
              "description": "The API server is an endpoint, not a selectable pod. Without this the agent cannot watch, read events or act.",
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$" }
            },
            "apiServerPorts": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
            },
            "extraEgressCIDRs": {
              "description": "The LLM API and the notification endpoints. Empty means no escalation can reach a person.",
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$" }
            },
            "extraEgressPorts": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    },

    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "nodeRole": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "securityContext": {
      "type": "object",
      "properties": {
        "readOnlyRootFilesystem": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podAnnotations": { "type": "object" },

    "extraEnv": {
      "type": "array",
      "description": "Extra env vars, appended last. Reserved names are refused in _helpers.tpl.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "string" },
          "valueFrom": { "type": "object" }
        },
        "additionalProperties": false
      }
    },

    "extraEnvFrom": {
      "type": "array",
      "description": "Extra envFrom sources (configMapRef / secretRef).",
      "items": { "type": "object" }
    }
  }
}
