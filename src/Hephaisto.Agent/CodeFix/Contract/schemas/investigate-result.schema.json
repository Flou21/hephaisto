{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrueRelevance/dev-context/schemas/investigate-result.schema.json",
  "title": "InvestigateResult",
  "description": "What the investigate phase returns, as the last framed block on stdout. The findings themselves are NOT here: the agent records them by calling the endpoint's conclude tool, which Hephaisto persists. This is the runner's account of the run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "attempt_id", "phase", "outcome", "cost_usd", "billing", "input_tokens", "output_tokens", "turns", "model", "session_id", "context_sha", "source", "code_refs", "error", "denied_tool_calls"],
  "properties": {
    "contract_version": { "const": "1" },
    "attempt_id": { "type": "string", "format": "uuid" },
    "phase": { "const": "investigate" },
    "outcome": {
      "enum": ["concluded", "no_conclusion", "budget_exhausted", "max_turns", "rate_limited", "no_credential", "failed"],
      "description": "concluded = the agent called the endpoint's conclude tool and it returned without error."
    },
    "cost_usd": { "type": "number", "minimum": 0, "description": "The SDK's total_cost_usd; notional on a subscription." },
    "billing": { "enum": ["subscription", "api", "fake"], "description": "Which credential paid: CLAUDE_CODE_OAUTH_TOKEN = subscription, ANTHROPIC_API_KEY = api, the fake SDK = fake." },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "turns": { "type": "integer", "minimum": 0 },
    "model": { "type": ["string", "null"], "maxLength": 128 },
    "session_id": { "type": ["string", "null"], "maxLength": 128 },
    "context_sha": { "type": ["string", "null"], "maxLength": 64 },
    "source": {
      "description": "Null when the request's source was null.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/source" }
      ]
    },
    "code_refs": {
      "type": "array",
      "maxItems": 20,
      "description": "The conclude call's code_refs that the runner confirmed exist in the clone at analysed_ref (file present, line within it). Empty when there was no source.",
      "items": { "$ref": "#/$defs/code_ref" }
    },
    "error": { "type": ["string", "null"], "maxLength": 4000 },
    "denied_tool_calls": { "$ref": "#/$defs/denials" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloned", "analysed_ref", "error"],
      "properties": {
        "cloned": { "type": "boolean" },
        "analysed_ref": { "type": ["string", "null"], "maxLength": 64 },
        "error": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "code_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding", "path", "line", "end_line", "note"],
      "properties": {
        "finding": { "type": "integer", "minimum": 0, "maximum": 9, "description": "Index into the conclude call's findings." },
        "path": { "type": "string", "maxLength": 512, "description": "Relative to the repository root." },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 },
        "note": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "denials": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "input", "reason"],
        "properties": {
          "tool": { "type": "string", "maxLength": 64 },
          "input": { "type": "string", "maxLength": 500 },
          "reason": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
