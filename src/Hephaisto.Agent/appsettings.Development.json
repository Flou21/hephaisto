{
  // The development cluster's name, for `dotnet run` and the eval harness. Never in
  // appsettings.json, which ships in the image (backlog #139).
  "Cluster": {
    "Name": "studio-rancher-desktop"
  },
  "Kubernetes": {
    // A developer kubeconfig against Rancher Desktop is cluster-admin, so every MUST-NOT
    // probe in the RBAC self-check comes back allowed and Enforce would refuse to boot.
    // WarnOnly keeps the check visible without making local development impossible.
    // The Deployment manifest deliberately leaves this at the Enforce default - the check
    // is only meaningful against the ServiceAccount it was written for.
    "RbacMode": "WarnOnly"
  },
  "Logging": {
    "LogLevel": {
      "Hephaisto": "Debug"
    }
  },
  "Policy": {
    // A local run points at the dev cluster's chaos namespace. Deliberately NOT in
    // appsettings.json: that one ships in the image, and a published default permitting
    // action somewhere would break the "empty means act nowhere" promise the chart,
    // the write Role and PolicyOptions itself all make.
    "AllowedNamespaces": [
      "hephaisto-chaos"
    ]
  }
}
