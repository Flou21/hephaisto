{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      // The issue poller asks GitHub once per repository per interval, for ever, and the HTTP
      // client's own four lines per request say nothing its outcome does not: a failure is
      // logged by the poller, once per change, and counted in hephaisto.github.polls.
      "System.Net.Http.HttpClient.IGitHubClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  // No cluster name here, deliberately (backlog #139). Cluster:Name is required and has no
  // default: this file ships inside the image, and a name in it is a fact about one machine
  // that every other install inherits. The chart sets it from cluster.name.
  "Kubernetes": {
    "RbacMode": "Enforce"
  },
  "Policy": {
    // Empty means act nowhere, and this file ships inside the image. The chart supplies
    // Policy__AllowedNamespaces__N from policy.actionableNamespaces - the same list that
    // renders the write RBAC Role - so the grant and the policy cannot disagree. A namespace
    // named here would be a second source of truth that no helm value could take away.
    "AllowedNamespaces": [],
    "AutoEnabledActionTypes": []
  },
  // ---------------------------------------------------------------------------------------
  // Incident sweeping - the producers Expire() and ApprovalTimedOut never had (#109, #44)
  // ---------------------------------------------------------------------------------------
  // OFF by default. With it off, an unanswered incident stays open forever and the open count
  // only ever rises - which is the defect, but turning it on changes what the console shows
  // without anyone asking, and on a new install seeing the backlog is the point before
  // draining it.
  //
  // .NET TimeSpan format, "d.hh:mm:ss" or "hh:mm:ss". NOT Go/Prometheus duration: "72h" does
  // not parse and the agent fails to start with a binding error.
  // ---------------------------------------------------------------------------------------
  // Authentication - OFF by default, and it FAILS CLOSED when on
  // ---------------------------------------------------------------------------------------
  // With this off there is no authentication of any kind: anything that can reach the console
  // port reads every incident - which carries pod logs and ConfigMap contents gathered from
  // every namespace - and can approve an action.
  //
  // When on, an unreachable IdP means an unavailable agent. That is the decision: dropping to
  // an unauthenticated console whenever the IdP is down would make the control decorative and
  // hand an attacker its timing.
  //
  // RequireHttpsMetadata may legitimately be false for an in-cluster issuer such as
  // http://keycloak.infra-auth:8080/realms/x - the traffic never leaves the cluster. It is an
  // explicit setting rather than something inferred from the scheme, because inferring it would
  // silently accept a downgraded authority on an install that meant to use a public one.
  "Auth": {
    "Enabled": false,
    "Authority": "",
    "ClientId": "hephaisto",
    "RequireHttpsMetadata": true,
    // Keycloak nests realm roles under realm_access.roles, which no standard mapping flattens.
    "RolesClaim": "roles",
    // Empty means any authenticated user. Leaving ApproverRole empty is logged at startup:
    // "anyone who can log in may approve a cluster change" is a choice, not a default.
    "ReaderRole": "",
    "ApproverRole": ""
  },

  // ---------------------------------------------------------------------------------------
  // Behind a TLS-terminating ingress with Auth on, set TrustForwardedHeaders: without it the OIDC
  // redirect URI goes out as http:// and the sign-in cookies lose Secure, so login loops. Only
  // when the console is reachable solely through that proxy - the headers are trusted from any peer.
  // ---------------------------------------------------------------------------------------
  "Web": {
    "TrustForwardedHeaders": false
  },

  "IncidentSweep": {
    "Enabled": false,
    "Interval": "00:15:00",
    // Measured from the last SIGNAL, not from when the incident opened: a fault still firing
    // keeps its incident alive however old it is, and only silence expires one.
    "ExpireAfter": "3.00:00:00",
    // Shorter on purpose. A day-old proposal is stale advice - the cluster has moved, and
    // executing it then would act on facts that are no longer true.
    "ApprovalTimeout": "24:00:00",
    "MaxPerPass": 200
  },

  // ---------------------------------------------------------------------------------------
  // Code fixes (v0.9.0) - a second, separately gated stage. OFF unless Mode is raised.
  // ---------------------------------------------------------------------------------------
  // Off | Plan | Pr. Silence and anything unparseable mean Off. The chart emits CodeFix__Mode and
  // the codeFixMode key of the switch ConfigMap from codeFix.mode; the most restrictive wins, and
  // the agent's kill switch (Off, emergency stop, runaway latch) overrides both.
  //
  // Pr needs Auth:Enabled - approving a repository write needs an authenticated human.
  //
  // Repositories is the operator's authorization list, workload key -> repository:
  //   { "Workload": "cait/Deployment/cait-matching-service",
  //     "Url": "https://github.com/TrueRelevance/CaitMatchingService", "DefaultBranch": "main" }
  // The coder also refuses any repository dev-context's repos.yaml does not mark coderEnabled.
  "CodeFix": {
    "Namespace": "hephaisto-coder",
    "SecretName": "hephaisto-codefix",
    "ContextRepositoryRef": "main",
    "Repositories": [],
    // AllowedRepositoryHosts and EligibleCategories are deliberately NOT listed here. Configuration
    // merges lists by index, so a default in this file could be widened by the chart but never
    // removed: an operator could not take github.com away. Empty permits nothing; the chart
    // supplies [github.com] and [application]. `image` is never a default - a bad image is a build
    // or deploy problem, not a code one.
    "ConfidenceFloor": 0.7,
    "MaxCostUsdPerPlan": 5,
    "MaxCostUsdPerImplement": 15,
    "MaxCostUsdPerDay": 50,
    "MaxAttemptsPerRepositoryPerDay": 3,
    "MaxConcurrentJobs": 1,
    "PlanDeadline": "00:30:00",
    "ImplementDeadline": "01:00:00",
    "ApprovalTimeout": "3.00:00:00",
    "JobTtl": "01:00:00",
    "PollInterval": "00:00:15",
    "RequireGreenBuild": true,
    "AllowUnauthenticatedApproval": false
  },
  // Investigation in a Job (v0.12.0 F5). Off: every investigation runs in-process, as in v0.11.
  // Enabled needs the code-fix stage's namespace, image and Secret (the Job borrows them), an
  // EndpointUrl the Job can reach, and Executor "job" (env) plus the switch ConfigMap's
  // investigationExecutor key, most restrictive winning. Overflow and a failed Job fall back to
  // in-process.
  "Investigation": {
    "Job": {
      "Enabled": false,
      "Port": 8084,
      "MaxCostUsd": 2,
      "Deadline": "00:15:00",
      "MaxTurns": 60,
      "MaxConcurrentJobs": 1,
      "MaxJobsPerHour": 20,
      "FallbackToInProcess": true,
      "PollInterval": "00:00:03",
      "Source": { "Enabled": false }
    }
  }
}
