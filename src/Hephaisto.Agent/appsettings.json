{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ingest": {
    "ClusterName": "studio-rancher-desktop"
  },
  "Kubernetes": {
    "ClusterName": "studio-rancher-desktop",
    "RbacMode": "Enforce"
  },
  "Policy": {
    // Empty means act nowhere, and this file ships inside the image. The chart supplies
    // Policy__AllowedNamespaces__N from policy.actionableNamespaces - the same list that
    // renders the write RBAC Role - so the grant and the policy cannot disagree. A namespace
    // named here would be a second source of truth that no helm value could take away.
    "AllowedNamespaces": [],
    "AutoEnabledActionTypes": []
  },
  // ---------------------------------------------------------------------------------------
  // Incident sweeping - the producers Expire() and ApprovalTimedOut never had (#109, #44)
  // ---------------------------------------------------------------------------------------
  // OFF by default. With it off, an unanswered incident stays open forever and the open count
  // only ever rises - which is the defect, but turning it on changes what the console shows
  // without anyone asking, and on a new install seeing the backlog is the point before
  // draining it.
  //
  // .NET TimeSpan format, "d.hh:mm:ss" or "hh:mm:ss". NOT Go/Prometheus duration: "72h" does
  // not parse and the agent fails to start with a binding error.
  "IncidentSweep": {
    "Enabled": false,
    "Interval": "00:15:00",
    // Measured from the last SIGNAL, not from when the incident opened: a fault still firing
    // keeps its incident alive however old it is, and only silence expires one.
    "ExpireAfter": "3.00:00:00",
    // Shorter on purpose. A day-old proposal is stale advice - the cluster has moved, and
    // executing it then would act on facts that are no longer true.
    "ApprovalTimeout": "24:00:00",
    "MaxPerPass": 200
  }
}
