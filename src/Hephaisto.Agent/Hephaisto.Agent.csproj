<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>hephaisto-agent</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hephaisto.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Hephaisto.Core/Hephaisto.Core.csproj" />
    <ProjectReference Include="../Hephaisto.ServiceDefaults/Hephaisto.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KubernetesClient" />
    <PackageReference Include="Google.GenAI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Runbooks and prompt fragments are content, not embedded resources, so they
         can be live_update-synced into the pod and edited without a rebuild. -->
    <Content Include="Runbooks/**/*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Prompts/**/*.md" CopyToOutputDirectory="PreserveNewest" />

    <!-- Recorded investigations for the demo seed. Content for the same reason and shipped in
         the image, because the demo's whole claim is that it needs nothing fetched: no clone,
         no model, no cluster. Inert unless Demo:Seed is set. They live under this project
         rather than at the repository root so the Dockerfile, which copies src/ and nothing
         else, carries them without a special case. -->
    <Content Include="Demo/transcripts/*.json" CopyToOutputDirectory="PreserveNewest"
             Link="transcripts/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
