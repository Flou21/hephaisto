@using Hephaisto.Agent.CodeFix
@inject IncidentQueries Queries
@inject IServiceScopeFactory Scopes
@inject IIncidentNotifier Notifier
@implements IDisposable

<nav class="hp-nav">
    <div class="hp-brand">
        <span class="hp-brand-name">hephaisto</span>
        @* The mode belongs in the chrome, not on one page. Every screen here is read in the
           context of what the agent is currently permitted to do, and "observe" is the
           reason the plan section shows an empty execution column. *@
        <span class="hp-mode @ModeClass" title="@ModeTitle">@ModeText</span>
    </div>

    <ul class="hp-navlinks">
        <li>
            <NavLink href="" Match="NavLinkMatch.All">incidents</NavLink>
        </li>
        <li>
            @* The badge counts what needs somebody: a Job running now, or a plan waiting for a
               decision. PRs already opened are not counted - they are a forge's queue, not this
               console's - and a badge that never returns to zero is one people stop seeing. *@
            <NavLink href="codefixes" data-testid="nav-codefixes">
                code fixes
                @if (CodeFixBadge > 0)
                {
                    <span class="hp-nav-badge" data-testid="nav-codefixes-badge"
                          title="@_codeFixes!.Running running, @_codeFixes.AwaitingApproval awaiting approval">@CodeFixBadge</span>
                }
            </NavLink>
        </li>
        <li>
            <NavLink href="search">search</NavLink>
        </li>
        <li>
            <NavLink href="status">status</NavLink>
        </li>
    </ul>

    @* Static markup and a plain onclick, deliberately not an @@onclick handler. A theme is
       this browser's preference, stored in this browser, and making it a circuit round trip
       would mean it stops working while the circuit is down - which is exactly when someone
       is squinting at this page. It ships with no label because app.js writes the one that
       is true for this reader; a server-rendered label would be wrong for everybody who
       chose. *@
    <button type="button"
            class="hp-theme"
            data-theme-control
            data-testid="theme-control"
            title="Cycle the theme: system, light, dark. Remembered in this browser only."
            onclick="window.hephaisto.cycleTheme()">theme </button>

    @if (_status is { WatchdogStale: true })
    {
        <div class="hp-nav-alarm" title="The AgentWatchdog alert has stopped arriving. Something between Prometheus and this pod is broken.">
            <span class="glyph">!!</span> alert path
        </div>
    }
</nav>

@code {
    private AgentStatusView? _status;
    private CodeFixCounts? _codeFixes;
    private CancellationTokenSource? _cts;

    private int CodeFixBadge => _codeFixes is { } c ? c.Running + c.AwaitingApproval : 0;

    /// <summary>
    /// Slow on purpose. The mode and the watchdog change on the order of minutes; polling
    /// them at the incident list's cadence would multiply the database load of every open
    /// tab for information that is almost never different.
    /// </summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);

    private string ModeText => _status is null
        ? "…"
        : _status.RunawayLatched ? "observe (latched)" : _status.Mode.ToString().ToLowerInvariant();

    private string ModeClass => _status switch
    {
        null => "mode-unknown",
        { RunawayLatched: true } => "mode-latched",
        { Mode: AgentMode.Off } => "mode-off",
        { Mode: AgentMode.Observe } => "mode-observe",
        { Mode: AgentMode.DryRun } => "mode-dryrun",
        _ => "mode-auto",
    };

    private string ModeTitle => _status switch
    {
        null => "Loading agent mode",
        { RunawayLatched: true } => $"Runaway backstop latched: {_status?.LatchReason}. Configured mode is {_status?.Mode}; a human must re-arm.",
        { Mode: AgentMode.Observe } => "Observe: the agent diagnoses and never changes anything.",
        { Mode: AgentMode.DryRun } => "Dry run: every Kubernetes call carries dryRun=All.",
        { Mode: AgentMode.Auto } => "Auto (L3): allowlisted low-risk actions execute without asking.",
        _ => "Off: nothing is ingested or investigated.",
    };

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await RefreshAsync();
        _ = PollAsync(_cts.Token);
        _ = ListenAsync(_cts.Token);
    }

    /// <summary>
    /// The badge moves the moment an attempt does, rather than up to thirty seconds later: a plan
    /// becoming ready is the event somebody has to act on, and it should not wait for the poll.
    /// Only the counts are re-read - the mode and watchdog stay on the slow timer.
    /// </summary>
    private async Task ListenAsync(CancellationToken ct)
    {
        try
        {
            await foreach (var e in Notifier.SubscribeAsync(ct))
            {
                if (e.Kind != IncidentLiveEventKind.CodeFixChanged)
                {
                    continue;
                }

                await RefreshCodeFixesAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshCodeFixesAsync()
    {
        try
        {
            var ct = _cts?.Token ?? CancellationToken.None;
            _codeFixes = await Scopes.QueryAsync(q => q.CountsAsync(ct));
        }
        catch (Exception)
        {
            // Same rule as the mode badge: a database blip keeps the last known count rather than
            // taking the navigation down.
        }
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(PollInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Navigating away or closing the tab. Not a failure.
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            _status = await Queries.GetStatusAsync(_cts?.Token ?? CancellationToken.None);
        }
        catch (Exception) when (_cts is { IsCancellationRequested: true })
        {
            // Disposed mid-query.
        }
        catch (Exception)
        {
            // A database blip must not take the navigation down. The mode badge shows its
            // last known value; the status page is where a real diagnosis belongs.
        }

        // Outside the try above, and it never throws: a status query that failed must not also
        // freeze the code-fix count.
        await RefreshCodeFixesAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
