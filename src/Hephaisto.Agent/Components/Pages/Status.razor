@page "/status"
@inject IncidentQueries Queries
@implements IDisposable

<PageTitle>hephaisto — status</PageTitle>

<h1>status</h1>

@if (_status is null)
{
    <p class="hp-muted">@(_error ?? "loading…")</p>
}
else
{
    var s = _status;

    <p class="hp-muted mono">as of @Display.Timestamp(s.Now)</p>

    @if (_error is not null)
    {
        <p class="hp-error"><span class="glyph">!!</span> last refresh failed: @_error — showing the previous reading.</p>
    }

    <section class="hp-section">
        <h2>mode</h2>

        <div class="hp-status-grid">
            <div class="hp-stat">
                <span class="hp-stat-label">configured</span>
                <span class="hp-stat-value mono">@s.Mode.ToString().ToLowerInvariant()</span>
                <span class="hp-muted">
                    by @(s.ModeChangedBy ?? "—") at @Display.Timestamp(s.ModeChangedAt)
                </span>
            </div>

            <div class="hp-stat">
                @* The distinction the kill switch turns on. Configured mode is what a human
                   last asked for in the database; effective mode is the most restrictive of
                   the env var, the switch ConfigMap and that row. A status page showing only
                   one of them would be wrong in exactly the case that matters — someone has
                   hit the ConfigMap and the row has not caught up. *@
                <span class="hp-stat-label">effective</span>
                <span class="hp-stat-value mono @(s.EffectiveMode < s.Mode ? "hp-alarm" : "")">
                    @s.EffectiveMode.ToString().ToLowerInvariant()
                </span>
                <span class="hp-muted">
                    @(s.EffectiveMode == s.Mode
                        ? "matches configuration"
                        : $"held back by {s.ModeDecidedBy}")
                </span>
            </div>
        </div>

        @if (s.ModeArms.Count > 0)
        {
            @* Every arm, always — not just when they disagree. "Which of the three do I
               change to stop this thing" is the question asked under pressure, and it must
               be answerable by looking rather than by remembering. *@
            <details class="hp-arms">
                <summary class="hp-muted">
                    kill switch: @s.ModeArms.Count arms, bound by <span class="mono">@s.ModeDecidedBy</span>
                </summary>
                <ul class="mono">
                    @foreach (var arm in s.ModeArms)
                    {
                        <li>@arm</li>
                    }
                </ul>
            </details>
        }

        @if (s.ModeConstrained)
        {
            <div class="hp-callout callout-escalated">
                <span class="glyph">!!</span>
                <strong>an arm is holding the agent back</strong>
                <div class="hp-muted">
                    Something asked for a more permissive mode than <span class="mono">@s.EffectiveMode.ToString().ToLowerInvariant()</span>
                    and <span class="mono">@s.ModeDecidedBy</span> refused it. The most restrictive arm always
                    wins, so raising the others changes nothing until this one is raised.
                </div>
            </div>
        }

        @if (s.RunawayLatched)
        {
            <div class="hp-callout callout-escalated">
                <span class="glyph">!!</span>
                <strong>runaway backstop latched</strong>
                @if (s.LatchedAt is { } latchedAt)
                {
                    <span class="mono"> at @Display.Timestamp(latchedAt)</span>
                }
                <div>@s.LatchReason</div>
                <div class="hp-muted">
                    Every individual budget did its job — the spend stopped each hour — and it
                    kept happening anyway. A human must re-arm; an agent that could reset this
                    itself would have a delay, not a backstop.
                </div>
            </div>
        }

        @if (s.EffectiveMode == AgentMode.Observe && !s.RunawayLatched)
        {
            <p class="hp-note">
                <span class="glyph">i</span>
                Observe: the agent detects, investigates, diagnoses and annotates. It never
                changes anything. Plans on the incident pages were produced and judged but
                never executed.
            </p>
        }
    </section>

    <section class="hp-section">
        <h2>incidents</h2>

        <div class="hp-status-grid">
            <div class="hp-stat">
                <span class="hp-stat-label">open</span>
                <span class="hp-stat-value mono">@s.OpenIncidents</span>
                <span class="hp-muted"><a href="">see the list</a></span>
            </div>
            <div class="hp-stat">
                <span class="hp-stat-label">escalated</span>
                <span class="hp-stat-value mono @(s.EscalatedIncidents > 0 ? "hp-alarm" : "")">@s.EscalatedIncidents</span>
                <span class="hp-muted">handed to a human</span>
            </div>
        </div>
    </section>

    <section class="hp-section">
        <h2>llm budget</h2>

        <p class="hp-muted">
            Counted in Postgres, not in memory: the loop that burns a budget is usually the
            thing that killed the pod, so an in-memory counter would hand the restart a clean
            slate. At 100% the agent stops starting new investigations and keeps everything
            cheap running — detection, dedup, correlation and this UI.
        </p>

        @BudgetMeter("tokens · this hour", s.HourlyTokenUtilization, s.WarnAtUtilization)
        @BudgetMeter("cost · this hour", s.HourlyCostUtilization, s.WarnAtUtilization)
        @BudgetMeter("cost · today", s.DailyCostUtilization, s.WarnAtUtilization)
    </section>

    <section class="hp-section">
        <h2>alert path</h2>

        <p class="hp-muted">
            The <span class="mono">AgentWatchdog</span> alert fires permanently by design, so it
            carries no information about the cluster — the information is that it keeps
            arriving. If it stops, something between Prometheus and this pod is broken, and
            every one of those failures is otherwise silent from in here.
        </p>

        <div class="hp-status-grid">
            <div class="hp-stat">
                <span class="hp-stat-label">last seen</span>
                <span class="hp-stat-value mono @(s.WatchdogStale ? "hp-alarm" : "")">
                    @if (s.WatchdogLastSeenAt is { } seen)
                    {
                        <text>@Display.Duration(s.Now - seen) ago</text>
                    }
                    else
                    {
                        <text>never</text>
                    }
                </span>
                <span class="hp-muted mono">
                    @(s.WatchdogLastSeenAt is { } lastSeen ? Display.Timestamp(lastSeen) : "no delivery since this pod started")
                </span>
            </div>

            <div class="hp-stat">
                <span class="hp-stat-label">deliveries</span>
                <span class="hp-stat-value mono">@s.WatchdogReceipts</span>
                <span class="hp-muted">since process start</span>
            </div>
        </div>

        @if (s.WatchdogStale)
        {
            <div class="hp-callout callout-escalated">
                <span class="glyph">!!</span>
                <strong>My alert path is broken.</strong>
                The watchdog has not arrived for longer than @Display.Duration(WatchdogMonitor.StaleAfter).
                Check Prometheus rule evaluation, Alertmanager routing, the webhook receiver
                config and the NetworkPolicy in front of <span class="mono">/webhooks</span>.
                Until it returns, an empty incident list means nothing.
            </div>
        }
    </section>
}

@code {
    private AgentStatusView? _status;
    private string? _error;
    private CancellationTokenSource? _cts;

    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadAsync();
        _ = TickAsync(_cts.Token);
    }

    private async Task TickAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _status = await Queries.GetStatusAsync(_cts?.Token ?? CancellationToken.None);
            _error = null;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            // Keeps the previous reading on screen with the failure named. A status page that
            // blanks itself when its database blips reads as "nothing to report", which is
            // the most misleading thing it could say.
            _error = ex.Message;
        }
    }

    /// <summary>
    /// A meter with the warn threshold and the 100% line drawn on it.
    /// </summary>
    /// <remarks>
    /// The thresholds are marked rather than merely colouring the bar, because "68%" means
    /// nothing without knowing that warning starts at 80. Deliberately not clamped: a window
    /// sitting at 140% is a different fact from one sitting at 100%, and clamping the bar
    /// while printing the true number is how the two stop being distinguishable at a glance.
    /// </remarks>
    private RenderFragment BudgetMeter(string label, double utilization, double warnAt) => @<div class="hp-meter">
        <div class="hp-meter-head">
            <span class="hp-meter-label">@label</span>
            <span class="mono @MeterClass(utilization, warnAt)">@Display.Percent(utilization)</span>
            @if (utilization >= 1)
            {
                <span class="hp-alarm"><span class="glyph">!!</span> exhausted — no new investigations</span>
            }
            else if (utilization >= warnAt)
            {
                <span class="hp-warn"><span class="glyph">!</span> over the warn threshold</span>
            }
        </div>
        <div class="hp-meter-track">
            <div class="hp-meter-fill @MeterClass(utilization, warnAt)" style="width:@Bar(utilization)"></div>
            <div class="hp-meter-mark mark-warn" style="left:@Bar(warnAt)"
                 title="@Display.Percent(warnAt) — warn threshold"></div>
            <div class="hp-meter-mark mark-max" style="left:100%"
                 title="100% — new investigations stop here"></div>
        </div>
    </div>;

    private static string MeterClass(double utilization, double warnAt) =>
        utilization >= 1 ? "meter-exhausted" : utilization >= warnAt ? "meter-warn" : "meter-ok";

    /// <summary>Bar width is clamped so the track stays a track; the printed percentage is not.</summary>
    private static string Bar(double ratio) =>
        (Math.Clamp(ratio, 0, 1) * 100).ToString("F1", CultureInfo.InvariantCulture) + "%";

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
