@page "/incidents/{Id:guid}"
@inject IncidentQueries Queries
@inject IIncidentNotifier Notifier
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>hephaisto — @(_incident?.Title ?? "incident")</PageTitle>

@if (_incident is null)
{
    <h1>incident</h1>
    <p class="hp-muted">@(_loading ? "loading…" : "No incident with this id.")</p>
}
else
{
    var incident = _incident;

    @* ---------------------------------------------------------------
       1. Header
       --------------------------------------------------------------- *@
    <header class="hp-detail-header">
        <h1>@incident.Title</h1>

        <div class="hp-badges">
            <span class="hp-state @Display.StateClass(incident.State)">
                <span class="glyph">@Display.StateGlyph(incident.State)</span>
                @incident.State.ToString().ToLowerInvariant()
            </span>
            <span class="hp-sev @Display.SeverityClass(incident.Severity)">
                <span class="glyph">@Display.SeverityGlyph(incident.Severity)</span>
                @incident.Severity.ToString().ToLowerInvariant()
            </span>
            <span class="hp-chip mono">@incident.Kind</span>
            <span class="hp-chip mono" title="Agent mode when this incident opened">
                mode@@open: @incident.ModeAtOpen.ToString().ToLowerInvariant()
            </span>
        </div>

        <dl class="hp-kv">
            <dt>target</dt>
            <dd class="mono">@incident.Target.Namespace/@incident.Target.Kind/@incident.Target.Name</dd>

            <dt title="Cooldowns, budgets and oscillation detection are all keyed on this, never on the pod name">workload</dt>
            <dd class="mono">@incident.Target.WorkloadKey</dd>

            @if (incident.Target.NodeName is { Length: > 0 })
            {
                <dt>node</dt>
                <dd class="mono">@incident.Target.NodeName</dd>
            }

            <dt>opened</dt>
            <dd class="mono">@Display.Timestamp(incident.OpenedAt)</dd>

            <dt>duration</dt>
            <dd class="mono">
                @Display.Duration(incident.DurationAt(_now))
                @if (incident.ResolvedAt is null)
                {
                    <span class="hp-muted"> (running)</span>
                }
            </dd>

            <dt>correlation key</dt>
            <dd class="mono">@incident.CorrelationKey</dd>

            <dt>incident id</dt>
            <dd class="mono">@incident.Id</dd>
        </dl>

        @if (incident.EscalationReason != EscalationReason.None)
        {
            <div class="hp-callout callout-escalated">
                <span class="glyph">^</span>
                <strong>escalated</strong>: @incident.EscalationReason
                <span class="hp-muted">— a human was asked to take this, and the agent stopped.</span>
            </div>
        }

        @if (incident.SuppressionReason != SuppressionReason.None)
        {
            <div class="hp-callout callout-suppressed">
                <span class="glyph">-</span>
                <strong>suppressed</strong>: @incident.SuppressionReason
                <span class="hp-muted">— recorded but deliberately not investigated.</span>
            </div>
        }

        @if (incident.QuarantinedUntil is { } until && until > _now)
        {
            <div class="hp-callout callout-quarantine">
                <span class="glyph">!!</span>
                <strong>quarantined</strong> until @Display.Timestamp(until)
                <span class="hp-muted">— the oscillation detector saw this workload flip back and
                forth; no action may be taken on it and incidents escalate straight to a human.</span>
            </div>
        }

        @if (incident.Resolution is { Length: > 0 })
        {
            <div class="hp-callout callout-resolved">
                <span class="glyph">+</span> @incident.Resolution
            </div>
        }

        @* A retry, for the incidents that never got an answer. An investigation that faults,
           stalls or exhausts its budget leaves the incident escalated with nothing to read,
           and until this existed the only way to get another attempt was to make the alert
           fire again. *@
        @if (CanReinvestigate)
        {
            <div class="hp-callout callout-retry">
                <span class="glyph">~</span>
                <div class="hp-retry">
                    <div>
                        <strong>no diagnosis was produced.</strong>
                        <span class="hp-muted">
                            Re-investigating starts a fresh attempt and spends the budget again.
                        </span>
                    </div>

                    <div class="hp-retry-controls">
                        <input class="hp-retry-name" placeholder="your name" aria-label="your name"
                               @bind="_submittedBy" @bind:event="oninput" />
                        <button type="button" class="hp-submit"
                                disabled="@(_retrying || string.IsNullOrWhiteSpace(_submittedBy))"
                                @onclick="ReinvestigateAsync">
                            @(_retrying ? "queueing…" : "re-investigate")
                        </button>
                    </div>

                    @if (_retryError is { Length: > 0 })
                    {
                        <span class="hp-error"><span class="glyph">!!</span> @_retryError</span>
                    }
                    else if (_retryMessage is { Length: > 0 })
                    {
                        <span class="hp-yes"><span class="glyph">+</span> @_retryMessage</span>
                    }
                </div>
            </div>
        }
    </header>

    @* ---------------------------------------------------------------
       2. Signal timeline
       --------------------------------------------------------------- *@
    <section class="hp-section">
        <h2>signals <span class="hp-count">@incident.Signals.Count</span></h2>

        @if (incident.Signals.Count == 0)
        {
            <p class="hp-empty">No signals attached. An incident without one should be impossible.</p>
        }
        else
        {
            <table class="hp-table">
                <thead>
                    <tr>
                        <th>source</th>
                        <th>kind</th>
                        <th>sev</th>
                        <th>reason</th>
                        <th>message</th>
                        <th class="c-time">first seen</th>
                        <th class="c-time">last seen</th>
                        <th class="c-num" title="Raw observations this row represents after burst collapse">count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var signal in incident.Signals)
                    {
                        <tr @key="signal.Id">
                            <td class="mono">@signal.Source</td>
                            <td class="mono">@signal.Kind</td>
                            <td>
                                <span class="hp-sev @Display.SeverityClass(signal.Severity)">
                                    <span class="glyph">@Display.SeverityGlyph(signal.Severity)</span>
                                    @signal.Severity.ToString().ToLowerInvariant()
                                </span>
                            </td>
                            <td class="mono">@signal.Reason</td>
                            <td class="hp-msg">
                                @* Untrusted text straight from the cluster. Razor escapes it;
                                   never render a signal message as markup. *@
                                @signal.Message
                                @if (signal.Labels.Count > 0)
                                {
                                    <details class="hp-labels">
                                        <summary>@signal.Labels.Count labels</summary>
                                        <dl class="hp-kv mono">
                                            @foreach (var (key, value) in signal.Labels.OrderBy(l => l.Key, StringComparer.Ordinal))
                                            {
                                                <dt>@key</dt>
                                                <dd>@value</dd>
                                            }
                                        </dl>
                                    </details>
                                }
                            </td>
                            <td class="c-time mono">@Display.Timestamp(signal.FirstSeen)</td>
                            <td class="c-time mono">@Display.Timestamp(signal.LastSeen)</td>
                            <td class="c-num mono">@signal.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (incident.Transitions.Count > 0)
        {
            <details class="hp-transitions">
                <summary>state transitions (@incident.Transitions.Count)</summary>
                <ol class="hp-timeline">
                    @foreach (var t in incident.Transitions)
                    {
                        <li @key="t.Id">
                            <span class="mono hp-muted">@Display.Timestamp(t.At)</span>
                            <span class="mono">@(t.From?.ToString() ?? "—") → @t.To</span>
                            <span>@t.Reason</span>
                        </li>
                    }
                </ol>
            </details>
        }
    </section>

    @* ---------------------------------------------------------------
       3. Investigation trace — the reason this page exists.

       Everything else here can be reconstructed from Postgres by hand. This cannot: it is
       the only place a human can see what the agent looked at, in what order, what came
       back, and what it was told. Deciding whether to ever give this thing write access is
       a judgement made from this list.
       --------------------------------------------------------------- *@
    <section class="hp-section">
        <h2>investigations <span class="hp-count">@incident.Investigations.Count</span></h2>

        @if (incident.InProgress is { } live)
        {
            @* Shown above the finished ones, and before any of them exist. An investigation
               writes its row only when it terminates, so without this the section reads
               "Never investigated" for the entire minutes-long run - on the page a reader is
               most likely to have open while it happens. *@
            <article class="hp-investigation hp-investigation-live">
                <header class="hp-investigation-head">
                    <span class="hp-running">
                        <span class="glyph">*</span> running
                    </span>
                    <span class="mono">@Display.Duration(_now - live.StartedAt)</span>
                    <span class="mono">@live.Model</span>
                </header>

                <dl class="hp-kv">
                    <dt>steps</dt><dd class="mono">@live.Steps</dd>
                    <dt>tool calls</dt><dd class="mono">@live.ToolCalls</dd>
                    <dt>spent</dt><dd class="mono">$@live.CostUsd.ToString("0.0000")</dd>
                    <dt>doing</dt>
                    <dd class="mono">@(live.Activity is { Length: > 0 } a ? a : "thinking")</dd>
                </dl>

                <h3>trace <span class="hp-muted">— live</span></h3>

                @if (live.StepLog.Count == 0)
                {
                    <p class="hp-empty">Waiting for the first model turn.</p>
                }
                else
                {
                    @* The same fields as a finished investigation's trace, minus the raw
                       expander. That omission is not a shortcut: RawBlobId points at a row
                       that is not written until the investigation commits, so offering the
                       expander here would be offering a link that cannot resolve. The digest
                       is what the model actually saw, and it is already in memory. *@
                    <ol class="hp-steps">
                        @foreach (var step in live.StepLog)
                        {
                            <li @key="step.Id">
                                <details class="hp-step @(step.Failed ? "step-failed" : "")">
                                    <summary>
                                        <span class="hp-ordinal mono">@step.Ordinal</span>
                                        <span class="hp-step-kind @(step.Kind == StepKind.ToolCall ? "kind-tool" : "kind-llm")">
                                            @(step.Kind == StepKind.ToolCall ? "tool" : "llm")
                                        </span>
                                        <span class="hp-step-name mono">@step.Label</span>
                                        @if (step.ToolServer is { Length: > 0 })
                                        {
                                            <span class="hp-server mono">@step.ToolServer</span>
                                        }
                                        <span class="hp-step-metrics mono">
                                            @Display.Millis(step.DurationMs)
                                            @if (step.InputTokens + step.OutputTokens > 0)
                                            {
                                                <text> · @Display.Tokens(step.InputTokens + step.OutputTokens) tok</text>
                                            }
                                            @if (step.CostUsd > 0)
                                            {
                                                <text> · @Display.Usd(step.CostUsd)</text>
                                            }
                                            @if (step.ResultBytes > 0)
                                            {
                                                <text> · @Display.Bytes(step.ResultBytes)</text>
                                            }
                                        </span>
                                        @if (step.ResultTruncated)
                                        {
                                            <span class="hp-truncated"><span class="glyph">~</span> truncated</span>
                                        }
                                        @if (step.Failed)
                                        {
                                            <span class="hp-failed"><span class="glyph">x</span> failed</span>
                                        }
                                    </summary>

                                    <div class="hp-step-body">
                                        @if (step.Error is { Length: > 0 })
                                        {
                                            <div class="hp-callout callout-error"><span class="glyph">x</span> @step.Error</div>
                                        }

                                        @if (step.Arguments is { Length: > 0 })
                                        {
                                            <h4>arguments</h4>
                                            <pre class="hp-code">@step.Arguments</pre>
                                        }

                                        @if (step.Kind == StepKind.ToolCall)
                                        {
                                            <h4>result digest <span class="hp-muted">— what the model actually saw</span></h4>
                                        }
                                        else
                                        {
                                            <h4>model output <span class="hp-muted">— its reasoning, and the tools it asked for</span></h4>
                                        }
                                        @if (string.IsNullOrEmpty(step.ResultDigest))
                                        {
                                            <p class="hp-empty">Still running.</p>
                                        }
                                        else
                                        {
                                            <pre class="hp-code">@step.ResultDigest</pre>
                                        }
                                    </div>
                                </details>
                            </li>
                        }
                    </ol>
                }

                <p class="hp-empty">
                    Findings, evidence and the plan are written when this finishes; they
                    commit together so a crash cannot leave half an investigation behind.
                </p>
            </article>
        }

        @if (incident.Investigations.Count == 0 && incident.InProgress is null)
        {
            <p class="hp-empty">
                Never investigated.
                @if (incident.EscalationReason == EscalationReason.BudgetExhausted)
                {
                    <text>The LLM budget was exhausted — see the <a href="status">status page</a>.</text>
                }
            </p>
        }

        @foreach (var inv in incident.Investigations)
        {
            <article class="hp-investigation" @key="inv.Id">
                <header class="hp-inv-header">
                    <span class="mono">@inv.ModelId</span>
                    <span class="hp-chip mono" title="Why the loop stopped. Concluded is the only clean exit.">
                        @inv.TerminationReason
                    </span>
                    <span class="hp-muted mono">
                        @inv.StepsUsed steps · @inv.ToolCallsUsed tool calls ·
                        @Display.Tokens(inv.InputTokens + inv.OutputTokens) tokens ·
                        @Display.Usd(inv.CostUsd)
                    </span>
                    <span class="hp-muted mono">
                        @Display.Timestamp(inv.StartedAt)
                        @if (inv.CompletedAt is { } done)
                        {
                            <text> · @Display.Duration(done - inv.StartedAt)</text>
                        }
                    </span>
                    @if (inv.TraceId is { Length: > 0 })
                    {
                        @* Text, not a link: the Grafana base URL is deployment configuration
                           and this layer has no business inventing one. *@
                        <span class="hp-muted mono" title="Trace id of the hephaisto.investigation span — paste into Tempo">
                            trace @inv.TraceId
                        </span>
                    }
                </header>

                @if (inv.Error is { Length: > 0 })
                {
                    <div class="hp-callout callout-error"><span class="glyph">!!</span> @inv.Error</div>
                }

                @* --- steps --- *@
                <h3>trace</h3>
                <ol class="hp-steps">
                    @foreach (var step in inv.Steps)
                    {
                        <li @key="step.Id">
                            <details id="@StepAnchor(step.Id)" class="hp-step @(step.Failed ? "step-failed" : "")">
                                <summary>
                                    <span class="hp-ordinal mono">@step.Ordinal</span>
                                    <span class="hp-step-kind @(step.Kind == StepKind.ToolCall ? "kind-tool" : "kind-llm")">
                                        @(step.Kind == StepKind.ToolCall ? "tool" : "llm")
                                    </span>
                                    <span class="hp-step-name mono">@step.Label</span>
                                    @if (step.ToolServer is { Length: > 0 })
                                    {
                                        <span class="hp-server mono" title="Which server answered">@step.ToolServer</span>
                                    }
                                    <span class="hp-step-metrics mono">
                                        @Display.Millis(step.DurationMs)
                                        @if (step.InputTokens + step.OutputTokens > 0)
                                        {
                                            <text> · @Display.Tokens(step.InputTokens + step.OutputTokens) tok</text>
                                        }
                                        @if (step.CostUsd > 0)
                                        {
                                            <text> · @Display.Usd(step.CostUsd)</text>
                                        }
                                        @if (step.ResultBytes > 0)
                                        {
                                            <text> · @Display.Bytes(step.ResultBytes)</text>
                                        }
                                    </span>
                                    @if (step.ResultTruncated)
                                    {
                                        @* Never hidden. A digest that dropped most of its input
                                           and a digest that did not are different evidence, and a
                                           reader who cannot tell them apart is being misled. *@
                                        <span class="hp-truncated" title="The model was shown a shortened result; the rest is in the raw blob">
                                            <span class="glyph">~</span> truncated
                                        </span>
                                    }
                                    @if (step.Failed)
                                    {
                                        <span class="hp-failed"><span class="glyph">x</span> failed</span>
                                    }
                                </summary>

                                <div class="hp-step-body">
                                    @if (step.Error is { Length: > 0 })
                                    {
                                        <div class="hp-callout callout-error"><span class="glyph">x</span> @step.Error</div>
                                    }

                                    @if (step.Arguments is { Length: > 0 })
                                    {
                                        <h4>arguments</h4>
                                        <pre class="hp-code">@step.Arguments</pre>
                                    }

                                    @if (step.Kind == StepKind.ToolCall)
                                    {
                                        <h4>
                                            result digest
                                            <span class="hp-muted">— what the model actually saw</span>
                                        </h4>
                                    }
                                    else
                                    {
                                        <h4>
                                            model output
                                            <span class="hp-muted">— its reasoning, and the tools it asked for</span>
                                        </h4>
                                    }
                                    @if (string.IsNullOrEmpty(step.ResultDigest))
                                    {
                                        @if (step.Kind == StepKind.ToolCall)
                                        {
                                            <p class="hp-empty">Empty. The model was shown nothing by this step.</p>
                                        }
                                        else
                                        {
                                            @* Turns recorded before model output was captured, and turns that
                                               genuinely produced neither text nor a tool call. *@
                                            <p class="hp-empty">No output recorded for this turn.</p>
                                        }
                                    }
                                    else
                                    {
                                        <pre class="hp-code">@step.ResultDigest</pre>
                                    }

                                    @if (step.RawBlobId is { } blobId)
                                    {
                                        <details class="hp-raw" @onclick="() => LoadBlobAsync(blobId)">
                                            <summary>raw result <span class="mono hp-muted">@blobId</span></summary>
                                            @if (_blobs.TryGetValue(blobId, out var blob))
                                            {
                                                @if (blob is null)
                                                {
                                                    <p class="hp-empty">
                                                        <span class="glyph">.</span>
                                                        Expired. Evidence blobs are kept 30 days; the digest above is
                                                        retained and is what grounding was checked against.
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="hp-muted mono">
                                                        @Display.Bytes(blob.TotalBytes) · @blob.ContentType ·
                                                        expires @Display.Timestamp(blob.ExpiresAt)
                                                        @if (blob.Clipped)
                                                        {
                                                            <text> · showing the first @Display.Bytes(blob.Content.Length) —
                                                            <a href="/api/evidence-blobs/@blobId">full blob</a></text>
                                                        }
                                                    </p>
                                                    <pre class="hp-code hp-raw-code">@blob.Content</pre>
                                                }
                                            }
                                            else
                                            {
                                                <p class="hp-muted">loading…</p>
                                            }
                                        </details>
                                    }
                                </div>
                            </details>
                        </li>
                    }
                </ol>

                @* --- findings --- *@
                <h3>findings <span class="hp-count">@inv.Findings.Count</span></h3>

                @if (inv.Findings.Count == 0)
                {
                    <p class="hp-empty">
                        No surviving findings. A finding whose evidence failed the grounding check is
                        dropped rather than shown as fact, so this can mean the model concluded nothing
                        <em>or</em> that everything it claimed failed verification.
                    </p>
                }
                else
                {
                    @foreach (var finding in inv.Findings)
                    {
                        <article class="hp-finding @(finding.IsPrimary ? "finding-primary" : "")" @key="finding.Id"
                                 data-testid="@(finding.IsPrimary ? "primary-finding" : "finding")">
                            <header>
                                @if (finding.IsPrimary)
                                {
                                    <span class="hp-chip chip-primary" title="The hypothesis the plan is built on">primary</span>
                                }
                                <span class="hp-chip mono">@finding.Category</span>

                                @* A bar and the number, never a word. "high confidence" invents a
                                   calibration nobody measured; 0.71 next to a bar lets a reader
                                   apply their own, and lets a wrong-but-confident finding look
                                   exactly as confident as it claimed to be. *@
                                <span class="hp-conf" title="Model's own estimate. Advisory, uncalibrated — not a measured probability.">
                                    <span class="hp-conf-track">
                                        <span class="hp-conf-fill" style="width:@Width(finding.Confidence)"></span>
                                    </span>
                                    <span class="mono">@finding.Confidence.ToString("F2")</span>
                                </span>
                            </header>

                            <p class="hp-hypothesis" data-testid="hypothesis">@finding.Hypothesis</p>

                            @if (finding.Evidence.Count == 0)
                            {
                                <p class="hp-empty">No evidence. This finding cites nothing and should not have survived.</p>
                            }
                            else
                            {
                                <ul class="hp-evidence">
                                    @foreach (var ev in finding.Evidence)
                                    {
                                        <li @key="ev.Id" data-testid="evidence">
                                            @* The grounding invariant, made clickable. Every excerpt must
                                               appear verbatim in the result digest of the step it names;
                                               this link is how a reader checks that themselves instead of
                                               taking the claim on trust. It is the whole point. *@
                                            @if (ev.StepOrdinal is { } ordinal)
                                            {
                                                <button type="button" class="hp-cite" @onclick="() => GoToStepAsync(ev.StepId)"
                                                        title="Jump to the step this quotes">
                                                    step @ordinal
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="hp-cite hp-cite-broken"
                                                      title="This evidence names a step that is not in this investigation. The grounding verifier should have dropped it.">
                                                    <span class="glyph">!!</span> broken citation
                                                </span>
                                            }
                                            <blockquote class="hp-excerpt mono">@ev.Excerpt</blockquote>
                                            @if (ev.SourceUri is { Length: > 0 })
                                            {
                                                <span class="hp-muted mono hp-source">@ev.SourceUri</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </article>
                    }
                }

                @* --- plan --- *@
                <h3>plan</h3>
                @if (inv.Plan is null)
                {
                    <p class="hp-empty">No plan was produced.</p>
                }
                else
                {
                    var plan = inv.Plan;

                    @* The banner used to say "observe mode, nothing was executed" unconditionally,
                       which stopped being true the moment an executor existed. It now reads the
                       actions themselves rather than asserting a mode. *@
                    var executed = plan.Actions.Any(a => a.ExecutedAt is not null && !a.DryRun);
                    var awaiting = plan.Actions.Any(a => a.State == ActionState.AwaitingApproval);

                    <div class="hp-plan-banner">
                        <span class="glyph">!</span>
                        @if (executed)
                        {
                            <strong>This was executed against the cluster.</strong>
                        }
                        else if (awaiting)
                        {
                            <strong>Waiting for a human. Nothing has been executed.</strong>
                        }
                        else
                        {
                            <strong>Would have done this — nothing was executed.</strong>
                        }
                        <span class="hp-muted">
                            The planning model holds no tools and emits JSON against a schema; execution
                            is separate C# over a closed action vocabulary. Every action below was judged
                            by the policy engine before anything could touch it.
                        </span>
                    </div>

                    @if (plan.Summary is { Length: > 0 })
                    {
                        <p class="hp-plan-summary">@plan.Summary</p>
                    }

                    @if (plan.NoActionRequired)
                    {
                        <p class="hp-empty">
                            <span class="glyph">+</span>
                            <strong>No action required.</strong> The model concluded this incident wants a
                            diagnosis rather than a change — which is the right answer for most of them.
                        </p>
                    }
                    else if (plan.Actions.Count == 0)
                    {
                        <p class="hp-empty">
                            The plan proposes no actions but did not say none were required. That gap is
                            itself worth reporting.
                        </p>
                    }
                    else
                    {
                        <table class="hp-table hp-plan">
                            <thead>
                                <tr>
                                    <th>action</th>
                                    <th>target</th>
                                    <th>risk</th>
                                    <th>predicted effect</th>
                                    <th>rollback</th>
                                    <th>policy</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var action in plan.Actions)
                                {
                                    <tr @key="action.Id">
                                        <td class="mono">
                                            @action.Type
                                            @if (action.Arguments is { Length: > 0 })
                                            {
                                                <details><summary>args</summary><pre class="hp-code">@action.Arguments</pre></details>
                                            }
                                        </td>
                                        <td class="mono">@action.Target.Namespace/@action.Target.Kind/@action.Target.Name</td>
                                        <td>
                                            <span class="hp-risk @Display.RiskClass(action.Risk)">
                                                @action.Risk.ToString().ToLowerInvariant()
                                            </span>
                                        </td>
                                        <td>@(action.PredictedEffect ?? "—")</td>
                                        <td>
                                            @if (action.RollbackSpec is { Length: > 0 })
                                            {
                                                <details><summary>spec</summary><pre class="hp-code">@action.RollbackSpec</pre></details>
                                            }
                                            else
                                            {
                                                @* Not cosmetic: an action with no rollback spec can never be
                                                   auto-executed, because a failed verification would have no
                                                   recourse. *@
                                                <span class="hp-no" title="No rollback spec — this action could never be auto-executed">
                                                    <span class="glyph">x</span> none
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="hp-decision @Display.DecisionClass(action.Decision)">
                                                <span class="glyph">@Display.DecisionGlyph(action.Decision)</span>
                                                @action.Decision.ToString().ToLowerInvariant()
                                            </span>
                                            @if (action.DecisionReasons.Count > 0)
                                            {
                                                <ul class="hp-reasons">
                                                    @foreach (var reason in action.DecisionReasons)
                                                    {
                                                        <li>@reason</li>
                                                    }
                                                </ul>
                                            }
                                            <div class="hp-muted mono hp-exec" data-testid="action-state">
                                                state @action.State
                                                @if (action.ExecutedAt is { } at)
                                                {
                                                    <text> · executed @Display.Timestamp(at)@(action.DryRun ? " (dry run)" : "")</text>
                                                }
                                                else
                                                {
                                                    <text> · never executed</text>
                                                }
                                                @if (action.ApprovedBy is { Length: > 0 } approver)
                                                {
                                                    <text> · by @approver (@action.ApprovalSource)</text>
                                                }
                                            </div>

                                            @if (action.State == ActionState.AwaitingApproval)
                                            {
                                                @* Goes through IncidentQueries, which goes through
                                                   TryAdmitActionAsync. A component must never write
                                                   State or call Kubernetes itself: the budget, cooldown
                                                   and kill-switch checks and the INSERT are one
                                                   transaction, and this is the seam that respects it. *@
                                                <div class="hp-retry-controls" data-testid="approval">
                                                    <input class="hp-retry-name" placeholder="your name"
                                                           aria-label="your name"
                                                           data-testid="approval-actor"
                                                           @bind="_approvalActor" @bind:event="oninput" />
                                                    <button type="button" class="hp-submit"
                                                            data-testid="approve"
                                                            disabled="@(_deciding is not null || string.IsNullOrWhiteSpace(_approvalActor))"
                                                            @onclick="() => DecideAsync(action.Id, true)">
                                                        @(_deciding == action.Id ? "…" : "approve")
                                                    </button>
                                                    <button type="button" class="hp-submit"
                                                            data-testid="deny"
                                                            disabled="@(_deciding is not null || string.IsNullOrWhiteSpace(_approvalActor))"
                                                            @onclick="() => DecideAsync(action.Id, false)">
                                                        deny
                                                    </button>
                                                </div>
                                            }

                                            @if (_decisionMessages.TryGetValue(action.Id, out var message))
                                            {
                                                <span class="@(message.Ok ? "hp-yes" : "hp-error")">
                                                    <span class="glyph">@(message.Ok ? "+" : "!!")</span> @message.Text
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </article>
        }
    </section>

    @* ---------------------------------------------------------------
       6. Feedback
       --------------------------------------------------------------- *@
    <section class="hp-section" id="feedback">
        <h2>feedback</h2>

        <p class="hp-muted">
            The only honest quality number here. Every other figure on this page — confidence,
            termination reason, predicted effect — is the agent assessing itself.
        </p>

        @if (incident.Feedback.Count > 0)
        {
            <ul class="hp-feedback-list">
                @foreach (var f in incident.Feedback)
                {
                    <li @key="f.Id">
                        <span class="@(f.Helpful ? "hp-yes" : "hp-no")">
                            <span class="glyph">@(f.Helpful ? "+" : "-")</span>
                            @(f.Helpful ? "helpful" : "not helpful")
                        </span>
                        @if (f.FalsePositive)
                        {
                            <span class="hp-chip chip-fp"><span class="glyph">!</span> false positive</span>
                        }
                        @if (f.RootCauseCorrect is { } rc)
                        {
                            <span class="hp-chip">root cause @(rc ? "correct" : "wrong")</span>
                        }
                        <span class="mono hp-muted">@f.SubmittedBy · @Display.Timestamp(f.At)</span>
                        @if (f.Comment is { Length: > 0 })
                        {
                            <p class="hp-comment">@f.Comment</p>
                        }
                    </li>
                }
            </ul>
        }

        <div class="hp-feedback-form">
            <div class="hp-field hp-thumbs">
                <span class="hp-label">was this useful?</span>
                <button type="button" class="hp-thumb @(_helpful == true ? "on" : "")" @onclick="() => _helpful = true">
                    <span class="glyph">+</span> yes
                </button>
                <button type="button" class="hp-thumb @(_helpful == false ? "on" : "")" @onclick="() => _helpful = false">
                    <span class="glyph">-</span> no
                </button>
            </div>

            <div class="hp-field">
                <span class="hp-label">was the root cause correct?</span>
                <select @bind="_rootCause">
                    <option value="">no opinion</option>
                    <option value="yes">yes</option>
                    <option value="no">no</option>
                </select>
            </div>

            <div class="hp-field">
                <label>
                    <input type="checkbox" @bind="_falsePositive" />
                    this incident should never have opened
                </label>
            </div>

            <div class="hp-field">
                <label class="hp-label" for="fb-comment">comment</label>
                <textarea id="fb-comment" rows="3" @bind="_comment"
                          placeholder="What did it get right or wrong?"></textarea>
            </div>

            <div class="hp-field">
                @* Required, and remembered in localStorage so nobody retypes it forty times.
                   ATTRIBUTION, NOT AUTHENTICATION: nothing verifies this string, and on a
                   single-operator tailnet cluster that is an accepted trade. The schema is
                   already OIDC-shaped, so the upgrade fills the same column from a verified
                   claim. If this ever runs where more than one person is on call, that
                   upgrade stops being a roadmap item. *@
                <label class="hp-label" for="fb-name">your name <span class="hp-req">required</span></label>
                <input id="fb-name" type="text" @bind="_submittedBy" @bind:event="oninput"
                       placeholder="who is saying this" autocomplete="off" />
                <span class="hp-muted">Attribution, not authentication — nothing checks this.</span>
            </div>

            <div class="hp-field">
                <button type="button" class="hp-submit" disabled="@(!CanSubmit)" @onclick="SubmitAsync">
                    submit
                </button>
                @if (_feedbackError is not null)
                {
                    <span class="hp-error"><span class="glyph">!!</span> @_feedbackError</span>
                }
                @if (_feedbackSaved)
                {
                    <span class="hp-yes"><span class="glyph">+</span> recorded</span>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private IncidentDetailView? _incident;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private bool _loading = true;

    /// <summary>
    /// Blob id to content. A null value means "looked up and gone" - blobs expire at 30 days
    /// while the step pointing at them is kept, so absence is a real state to render, not a
    /// gap to leave blank.
    /// </summary>
    private readonly Dictionary<Guid, EvidenceBlobView?> _blobs = [];

    /// <summary>Clip length for the in-page raw view. Enough to read a stack trace; far short
    /// of pushing a megabyte through the circuit and asking the browser to lay it out.</summary>
    private const int RawPreviewBytes = 64 * 1024;

    private bool? _helpful;
    private string _rootCause = string.Empty;
    private bool _falsePositive;
    private string _comment = string.Empty;
    private string _submittedBy = string.Empty;
    private string? _feedbackError;
    private bool _feedbackSaved;

    private const string NameStorageKey = "hephaisto.feedback.name";

    private bool _retrying;

    private string? _approvalActor;
    private Guid? _deciding;
    private readonly Dictionary<Guid, (bool Ok, string Text)> _decisionMessages = [];
    private string? _retryError;
    private string? _retryMessage;

    private CancellationTokenSource? _cts;

    private bool CanSubmit => _helpful is not null && !string.IsNullOrWhiteSpace(_submittedBy);

    protected override async Task OnParametersSetAsync()
    {
        // Cancel the previous incident's listener before starting this one's: Blazor reuses
        // the component instance when only the route parameter changes, so without this a
        // navigation between two incidents leaves the old subscription running forever.
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }

        _cts = new CancellationTokenSource();
        _blobs.Clear();
        _feedbackSaved = false;

        await LoadAsync();

        _ = ListenAsync(_cts.Token);
        _ = TickAsync(_cts.Token);
        _ = ClockAsync(_cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var remembered = await Js.InvokeAsync<string?>("hephaisto.storageGet", NameStorageKey);

            if (!string.IsNullOrWhiteSpace(remembered) && string.IsNullOrWhiteSpace(_submittedBy))
            {
                _submittedBy = remembered;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // Private browsing, a blocked storage API, or a script that failed to load. The
            // field simply starts empty; a console must not break because a convenience did.
        }
        catch (InvalidOperationException)
        {
            // Prerender or a circuit that has already gone away.
        }
    }

    private async Task LoadAsync()
    {
        var ct = _cts?.Token ?? CancellationToken.None;

        try
        {
            _incident = await Queries.GetDetailAsync(Id, ct);
            _now = DateTimeOffset.UtcNow;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Reloads this incident on a timer.
    /// </summary>
    /// <remarks>
    /// The notifier alone is not enough. It fires on incident transitions, and an
    /// investigation publishes nothing between starting and finishing - so a page opened on
    /// an incident being investigated right now sat unchanged for the whole run, which is
    /// exactly the page a reader is most likely to be watching. Five seconds rather than the
    /// list's ten because this is the page someone stares at while work is happening.
    /// </remarks>
    private async Task TickAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Advances the clock every second so ages count up smoothly, without a query.
    /// </summary>
    private async Task ClockAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                _now = DateTimeOffset.UtcNow;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>Only this incident's events matter here; a busy cluster publishes for
    /// everything, and reloading a detail page because an unrelated pod restarted is churn.</summary>
    private async Task ListenAsync(CancellationToken ct)
    {
        try
        {
            await foreach (var liveEvent in Notifier.SubscribeAsync(ct))
            {
                if (liveEvent.IncidentId != Id)
                {
                    continue;
                }

                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Fetched when the expander is opened, never with the page.
    /// </summary>
    /// <remarks>
    /// An investigation can hold fifty steps, each with a megabyte blob. Loading them all so
    /// that one might be read would turn opening an incident into fifty megabytes over the
    /// circuit, on the page someone reaches for during an outage.
    /// </remarks>
    private async Task LoadBlobAsync(Guid blobId)
    {
        if (_blobs.ContainsKey(blobId))
        {
            return;
        }

        // Claim the slot before awaiting: the click handler can fire twice before the first
        // query returns, and two in-flight reads of a megabyte is the thing being avoided.
        _blobs[blobId] = null;

        try
        {
            _blobs[blobId] = await Queries.GetBlobAsync(blobId, RawPreviewBytes, _cts?.Token ?? CancellationToken.None);
        }
        catch (OperationCanceledException)
        {
            _blobs.Remove(blobId);
        }
    }

    private async Task GoToStepAsync(Guid stepId)
    {
        try
        {
            await Js.InvokeVoidAsync("hephaisto.revealStep", StepAnchor(stepId));
        }
        catch (JSException)
        {
            // The anchor still exists in the DOM; only the scroll and the flash are lost.
        }
    }

    private async Task SubmitAsync()
    {
        _feedbackError = null;
        _feedbackSaved = false;

        if (_helpful is not { } helpful)
        {
            _feedbackError = "Pick yes or no.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_submittedBy))
        {
            _feedbackError = "A name is required.";
            return;
        }

        try
        {
            var saved = await Queries.AddFeedbackAsync(
                Id,
                helpful,
                _rootCause switch { "yes" => true, "no" => false, _ => null },
                _falsePositive,
                _comment,
                _submittedBy,
                _cts?.Token ?? CancellationToken.None);

            if (saved is null)
            {
                _feedbackError = "This incident no longer exists.";
                return;
            }

            _feedbackSaved = true;
            _comment = string.Empty;

            await LoadAsync();

            try
            {
                await Js.InvokeVoidAsync("hephaisto.storageSet", NameStorageKey, _submittedBy.Trim());
            }
            catch (JSException)
            {
                // Remembering the name is a convenience; the verdict is already committed.
            }
        }
        catch (Exception ex)
        {
            _feedbackError = ex.Message;
        }
    }

    /// <summary>
    /// Shown only for the give-up states, and only when nothing is already running.
    /// </summary>
    /// <remarks>
    /// Escalated and Expired are the two ways an incident stops without an answer. Suppressed
    /// is excluded deliberately - it was a duplicate and re-investigating it would pay twice
    /// for one problem - and Resolved belongs to the reopen path, which means something else.
    /// The in-flight check is a courtesy, not the guard: the state machine refuses
    /// Investigating -&gt; Investigating regardless of what this button believes.
    /// </remarks>
    /// <summary>
    /// A retry is offered when the incident ended without an answer, and only then.
    /// </summary>
    /// <remarks>
    /// The third clause is the one that was missing, and its absence made the callout beside
    /// it state something false. An incident escalates for several reasons and only some of
    /// them mean "nothing was produced": a run that faults or exhausts its budget leaves
    /// nothing to read, but an incident escalated because the POLICY ENGINE refused the plan
    /// has a complete diagnosis, a hypothesis and cited evidence sitting directly below this
    /// banner saying no diagnosis was produced. Every escalated incident in the demo corpus
    /// showed it, including one whose finding carries 0.92 confidence.
    ///
    /// The block's own comment always said "for the incidents that never got an answer" -
    /// the condition just never checked for one.
    /// </remarks>
    private bool CanReinvestigate =>
        _incident is { InProgress: null } incident
        && incident.State is IncidentState.Escalated or IncidentState.Expired
        && incident.Investigations.All(v => v.PrimaryFinding is null);

    private async Task ReinvestigateAsync()
    {
        if (_incident is null || string.IsNullOrWhiteSpace(_submittedBy))
        {
            return;
        }

        _retrying = true;
        _retryError = null;
        _retryMessage = null;

        try
        {
            var result = await Queries.RequestReinvestigationAsync(
                Id,
                _submittedBy,
                _cts?.Token ?? CancellationToken.None);

            if (result.Accepted)
            {
                _retryMessage = "queued — the live step trace appears here once a worker picks it up.";

                try
                {
                    await Js.InvokeVoidAsync("hephaisto.storageSet", NameStorageKey, _submittedBy.Trim());
                }
                catch (JSException)
                {
                    // Remembering the name is a convenience; the retry is already queued.
                }

                await LoadAsync();
            }
            else
            {
                // Detail carries the specific reason - the kill switch arm that bound the
                // mode, or the illegal transition. Falling back to the bare outcome name
                // still beats a silent no-op.
                _retryError = result.Detail ?? result.Outcome.ToString();
            }
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-request.
        }
        catch (Exception ex)
        {
            _retryError = ex.Message;
        }
        finally
        {
            _retrying = false;
        }
    }

    private static string StepAnchor(Guid stepId) => $"step-{stepId:N}";

    private static string Width(double confidence) =>
        (Math.Clamp(confidence, 0, 1) * 100).ToString("F1", CultureInfo.InvariantCulture) + "%";

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = null;
        }
    }

    /// <summary>
    /// Approves or denies one proposed action.
    /// </summary>
    /// <remarks>
    /// Calls the query layer, which admits the action through the same Serializable
    /// transaction everything else does and only then executes. This method deliberately does
    /// not touch ActionState, and must not: a component that set it would skip the budget,
    /// the cooldown and the kill switch, on the one path where losing that race means an
    /// unintended write.
    /// </remarks>
    private async Task DecideAsync(Guid actionId, bool approve)
    {
        if (string.IsNullOrWhiteSpace(_approvalActor) || _deciding is not null)
        {
            return;
        }

        _deciding = actionId;
        _decisionMessages.Remove(actionId);

        try
        {
            var result = await Queries.DecideActionAsync(
                Id, actionId, approve, _approvalActor, ApprovalSource.Ui,
                _cts?.Token ?? CancellationToken.None);

            _decisionMessages[actionId] = (result.Accepted, result.Detail ?? result.Outcome.ToString());

            await Js.InvokeVoidAsync("hephaisto.storageSet", "hephaisto.name", _approvalActor);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _decisionMessages[actionId] = (false, ex.Message);
        }
        finally
        {
            _deciding = null;
        }
    }
}
