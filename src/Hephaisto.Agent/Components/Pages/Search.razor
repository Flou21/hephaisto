@page "/search"
@inject IncidentQueries Queries
@implements IDisposable

<PageTitle>hephaisto — search</PageTitle>

<h1>search incident history</h1>

<p class="hp-muted">
    Digests, not raw logs. Evidence blobs expire at 30 days while a digest is kept
    indefinitely, so this reaches back further than anything it was written from — and a
    digest has to stand on its own for exactly that reason.
</p>

<div class="hp-searchbar">
    <input type="search" placeholder="CrashLoopBackOff on payments-api after 1.24.3"
           @bind="_query" @bind:event="oninput" @onkeydown="OnKeyDown" autocomplete="off" />
    <label>
        <input type="checkbox" @bind="_resolvedOnly" />
        resolved only
    </label>
    <button type="button" @onclick="RunAsync" disabled="@_searching">search</button>
</div>

@if (!_semanticAvailable)
{
    @* Said out loud rather than hidden. A reader who does not know the vector arm is off
       will read a thin result set as "this never happened before". *@
    <p class="hp-note">
        <span class="glyph">i</span>
        Lexical arm only — no embedding generator is wired up yet, so paraphrases
        ("pods keep dying after the deploy") will not match. Exact identifiers still will,
        which is what most of these queries are actually made of.
    </p>
}

@if (_error is not null)
{
    <p class="hp-error"><span class="glyph">!!</span> @_error</p>
}

@if (_searching)
{
    <p class="hp-muted">searching…</p>
}
else if (_ran && _hits.Count == 0)
{
    <p class="hp-empty">Nothing matched. Only incidents that produced a digest are indexed.</p>
}
else if (_hits.Count > 0)
{
    <p class="hp-muted mono">@_hits.Count hits</p>

    <ol class="hp-hits">
        @foreach (var hit in _hits)
        {
            <li @key="hit.DigestId">
                <header>
                    <a href="incidents/@hit.IncidentId" class="hp-hit-target mono">
                        @hit.Namespace/@hit.WorkloadKey
                    </a>
                    <span class="hp-chip mono">@hit.Kind</span>
                    @if (hit.Resolved)
                    {
                        <span class="hp-yes"><span class="glyph">+</span> resolved</span>
                    }
                    else
                    {
                        <span class="hp-no"><span class="glyph">-</span> unresolved</span>
                    }
                    <span class="hp-muted mono">@Display.Timestamp(hit.CreatedAt)</span>
                </header>

                <p class="hp-digest">@hit.Digest</p>

                @* Why it matched, not just that it did. The fused score is a rank-fusion
                   number that is comparable inside this result set and meaningless outside
                   it, so the ranks are shown next to it - "the lexical arm put this third"
                   is a statement a human can actually check. *@
                <footer class="hp-why mono">
                    score @hit.Score.ToString("F4", CultureInfo.InvariantCulture)
                    ·
                    @if (hit.LexicalRank is { } lexical)
                    {
                        <span class="hp-chip chip-lexical" title="Rank in the full-text arm — matched literal terms">
                            lexical #@lexical
                        </span>
                    }
                    else
                    {
                        <span class="hp-muted">no lexical match</span>
                    }
                    @if (hit.SemanticRank is { } semantic)
                    {
                        <span class="hp-chip chip-semantic" title="Rank in the vector arm — matched meaning">
                            semantic #@semantic
                        </span>
                    }
                </footer>
            </li>
        }
    </ol>
}

@code {
    private string _query = string.Empty;
    private bool _resolvedOnly;
    private bool _searching;
    private bool _ran;
    private string? _error;
    private IReadOnlyList<IncidentSearchHit> _hits = [];

    private CancellationTokenSource? _cts;

    /// <summary>
    /// Whether the vector arm actually ran, as reported by the search itself.
    /// </summary>
    /// <remarks>
    /// This used to be inferred from whether any hit came back carrying a semantic rank, which
    /// is wrong in exactly the case that matters: an arm that ran and legitimately matched
    /// nothing looks identical to an arm that never ran, so the page announced "semantic search
    /// unavailable" precisely when semantic search was working and had nothing to offer.
    /// </remarks>
    private bool _semanticAvailable;

    protected override void OnInitialized() => _cts = new CancellationTokenSource();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RunAsync();
        }
    }

    private async Task RunAsync()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            _hits = [];
            _ran = false;
            return;
        }

        _searching = true;
        _error = null;

        try
        {
            var result = await Queries.SearchAsync(
                _query,
                new SearchFilter { ResolvedOnly = _resolvedOnly },
                limit: 25,
                _cts?.Token ?? CancellationToken.None);

            _hits = result.Hits;
            _semanticAvailable = result.SemanticArmRan;
            _ran = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _hits = [];
        }
        finally
        {
            _searching = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
