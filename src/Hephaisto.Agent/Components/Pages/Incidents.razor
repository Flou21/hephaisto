@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IncidentQueries Queries
@inject IIncidentNotifier Notifier
@inject NavigationManager Nav
@inject IAuthorizationService Authorization
@implements IDisposable

<PageTitle>hephaisto — incidents</PageTitle>

<h1>incidents</h1>

<div class="hp-filters">
    <label>
        state
        <select value="@_state" @onchange="OnStateChanged">
            <option value="open">open</option>
            <option value="all">all</option>
            @foreach (var s in Enum.GetValues<IncidentState>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </label>

    <label>
        kind
        <select value="@_kind" @onchange="OnKindChanged">
            <option value="">any</option>
            @foreach (var k in Enum.GetValues<SignalKind>())
            {
                <option value="@k">@k</option>
            }
        </select>
    </label>

    <label>
        namespace
        <select value="@_namespace" @onchange="OnNamespaceChanged">
            <option value="">any</option>
            @foreach (var ns in _namespaces)
            {
                <option value="@ns">@ns</option>
            }
        </select>
    </label>

    <span class="hp-filter-status">
        @if (_loading)
        {
            <span class="hp-muted">loading…</span>
        }
        else
        {
            <span class="hp-muted">@_incidents.Count shown · refreshed @Display.TimeOnly(_refreshedAt)</span>
        }
        @if (_error is not null)
        {
            <span class="hp-error" title="@_error"><span class="glyph">!!</span> query failed</span>
        }
    </span>
</div>

@if (BulkFilter is not null && _viewer.MayDecide && _incidents.Count > 0)
{
    @* Closing by the filter, not by the rows on screen (#161): the table stops at 200 and a
       backlog does not. Two steps on purpose - the first only counts, and the second closes
       exactly that many or refuses. *@
    <div class="hp-retry hp-section" data-testid="bulk-close">
        <div class="hp-retry-controls">
            <ActorField Viewer="_viewer" @bind-Name="_closedBy" TestId="bulk-close-actor" />
            <input class="hp-retry-name" placeholder="reason for closing all of them" aria-label="reason for closing all of them"
                   data-testid="bulk-close-reason"
                   @bind="_bulkReason" @bind:event="oninput" />
            @if (_bulkCount is null)
            {
                <button type="button" class="hp-submit" data-testid="bulk-close-count"
                        disabled="@_bulkBusy" @onclick="CountBulkAsync">
                    @(_bulkBusy ? "…" : "close every open incident this filter matches…")
                </button>
            }
            else
            {
                <button type="button" class="hp-submit" data-testid="bulk-close-confirm"
                        disabled="@(_bulkBusy || _bulkCount == 0 || string.IsNullOrWhiteSpace(_bulkReason) || string.IsNullOrWhiteSpace(BulkActor))"
                        @onclick="CloseBulkAsync">
                    @(_bulkBusy ? "…" : $"close {_bulkCount} open incidents")
                </button>
                <button type="button" class="hp-submit" data-testid="bulk-close-cancel"
                        disabled="@_bulkBusy" @onclick="ResetBulk">
                    cancel
                </button>
            }
        </div>
        @if (_bulkCount is { } count)
        {
            <span class="hp-muted" data-testid="bulk-close-preview">
                @count open incidents match (@BulkFilter.Describe()). Each gets its own audit entry, with the reason.
            </span>
        }
        @if (_bulkMessage is { Length: > 0 })
        {
            <span class="hp-muted" data-testid="bulk-close-done">@_bulkMessage</span>
        }
        @if (_bulkError is { Length: > 0 })
        {
            <span class="hp-error" data-testid="bulk-close-error"><span class="glyph">!!</span> @_bulkError</span>
        }
    </div>
}

@if (_incidents.Count == 0 && !_loading)
{
    <p class="hp-empty">
        No incidents match this filter.
        @if (_state == "open")
        {
            <text>Nothing is currently wrong, or nothing has reached the agent — the
            <a href="status">status page</a> says which.</text>
        }
    </p>
}
else
{
    <table class="hp-table hp-incidents">
        <thead>
            <tr>
                <th class="c-state">state</th>
                <th class="c-sev">sev</th>
                <th class="c-kind">kind</th>
                <th class="c-target">workload</th>
                <th class="c-title">title</th>
                <th class="c-num">signals</th>
                <th class="c-diag">diagnosis</th>
                <th class="c-time">opened</th>
                <th class="c-time">duration</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var incident in _incidents)
            {
                <tr @key="incident.Id" class="hp-row" @onclick="() => Open(incident.Id)"
                    data-testid="incident-row" data-kind="@incident.Kind" data-target="@incident.TargetName">
                    <td class="c-state">
                        @* Glyph AND word AND colour. Two of the three survive a bad monitor
                           or a colour-blind reader; colour alone survives neither. *@
                        <span class="hp-state @Display.StateClass(incident.State)">
                            <span class="glyph">@Display.StateGlyph(incident.State)</span>
                            @incident.State.ToString().ToLowerInvariant()
                        </span>
                        @if (incident.State == IncidentState.Escalated && incident.EscalationReason != EscalationReason.None)
                        {
                            <span class="hp-sub">@incident.EscalationReason</span>
                        }
                        @if (incident.State == IncidentState.Suppressed && incident.SuppressionReason != SuppressionReason.None)
                        {
                            <span class="hp-sub">@incident.SuppressionReason</span>
                        }
                        @if (incident.AcknowledgedBy is { Length: > 0 } holder)
                        {
                            @* Not a state: acknowledging changes none, so it sits under whichever
                               one the incident is in. Without it an acknowledged incident and an
                               untouched one are the same row (#165). *@
                            <span class="hp-sub" data-testid="row-acknowledged-by">ack @ActorDisplay.Render(holder, incident.AcknowledgedClaimedBy)</span>
                        }
                    </td>
                    <td class="c-sev">
                        <span class="hp-sev @Display.SeverityClass(incident.Severity)">
                            <span class="glyph">@Display.SeverityGlyph(incident.Severity)</span>
                            @incident.Severity.ToString().ToLowerInvariant()
                        </span>
                    </td>
                    <td class="c-kind mono">@incident.Kind</td>
                    <td class="c-target mono" title="@incident.Namespace/@incident.Workload">
                        <span class="hp-ns">@incident.Namespace</span>/@incident.Workload
                    </td>
                    @* An anchor as well as the row handler: the row is a convenience for a
                       mouse, the link is what a keyboard and a middle-click need. *@
                    <td class="c-title"><a href="incidents/@incident.Id" data-testid="incident-link">@incident.Title</a></td>
                    <td class="c-num mono">@incident.SignalCount</td>
                    <td class="c-diag">
                        @if (incident.InProgress is { } live)
                        {
                            @* Live work outranks the stored result: this incident is being
                               investigated RIGHT NOW, and that is the most useful thing the
                               cell can say. The counters move on every model turn. *@
                            <span class="hp-running"
                                  title="@live.Model, started @Display.Timestamp(live.StartedAt)">
                                <span class="glyph">*</span>
                                running @Display.Duration(_now - live.StartedAt)
                                &middot; step @live.Steps
                                &middot; @live.ToolCalls tools
                                &middot; $@live.CostUsd.ToString("0.000")
                                @if (live.Activity is { Length: > 0 } act)
                                {
                                    <span class="hp-activity">@act</span>
                                }
                            </span>
                        }
                        else if (incident.State == IncidentState.Investigating)
                        {
                            @* Marked Investigating but no worker holds it. Worker concurrency
                               is 2, so waiting is the ordinary case under load and it is NOT
                               the same as being worked on - saying so is the whole point.

                               "waiting", not "queued": this row cannot tell the two apart.
                               The incident may be in the in-memory queue, or it may have been
                               stranded by a restart that killed its worker - StrandedIncident-
                               Requeue picks those up at the next start. Claiming "queued"
                               would be asserting something this page does not know. *@
                            <span class="hp-queued"
                                  title="triaged for investigation; no worker is running it right now">
                                <span class="glyph">.</span> waiting
                            </span>
                        }
                        else if (incident.HasDiagnosis)
                        {
                            <span class="hp-yes"><span class="glyph">+</span> yes</span>
                        }
                        else if (incident.InvestigationCount > 0)
                        {
                            @* Investigated but concluded nothing. A different fact from never
                               having tried, and the one worth looking at. *@
                            <span class="hp-partial" title="@incident.InvestigationCount investigation(s), no surviving finding">
                                <span class="glyph">~</span> none
                            </span>
                        }
                        else
                        {
                            <span class="hp-no"><span class="glyph">-</span> not run</span>
                        }
                    </td>
                    <td class="c-time mono" title="@Display.Timestamp(incident.OpenedAt)">@Display.Timestamp(incident.OpenedAt)</td>
                    <td class="c-time mono">@Display.Duration(incident.DurationAt(_now))</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<IncidentListItem> _incidents = [];
    private IReadOnlyList<string> _namespaces = [];
    private DateTimeOffset _refreshedAt;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private bool _loading = true;
    private string? _error;

    private string _state = "open";
    private string _kind = string.Empty;
    private string _namespace = string.Empty;

    private CancellationTokenSource? _cts;

    // ------------------------------------------------------------------
    // Closing everything a filter matches (#161)
    // ------------------------------------------------------------------

    private ConsoleViewer _viewer = ConsoleViewer.Anonymous;

    [Inject]
    private AuthenticationStateProvider? AuthProvider { get; set; }

    private string _closedBy = string.Empty;
    private string _bulkReason = string.Empty;
    private int? _bulkCount;
    private bool _bulkBusy;
    private string? _bulkMessage;
    private string? _bulkError;

    private string BulkActor => _viewer.Actor(_closedBy) ?? string.Empty;

    /// <summary>
    /// The page's filter as the bulk close takes it, or null when the filter shows incidents
    /// that are not open: there is nothing to close among those.
    /// </summary>
    private Hephaisto.Agent.Mcp.McpIncidentFilter? BulkFilter
    {
        get
        {
            var open = _state == "open"
                || (Enum.TryParse<IncidentState>(_state, ignoreCase: true, out var s) && HephaistoDbContext.OpenStates.Contains(s));

            return open
                ? new Hephaisto.Agent.Mcp.McpIncidentFilter
                {
                    State = _state,
                    Kind = string.IsNullOrEmpty(_kind) ? null : _kind,
                    Namespace = string.IsNullOrEmpty(_namespace) ? null : _namespace,
                }
                : null;
        }
    }

    private void ResetBulk()
    {
        _bulkCount = null;
        _bulkError = null;
    }

    private Task CountBulkAsync() => RunBulkAsync(expect: null);

    private Task CloseBulkAsync() => RunBulkAsync(expect: _bulkCount);

    private async Task RunBulkAsync(int? expect)
    {
        if (BulkFilter is not { } filter || !_viewer.MayDecide)
        {
            return;
        }

        _bulkBusy = true;
        _bulkError = null;
        _bulkMessage = null;

        try
        {
            // A dry run records nobody, so it needs no name yet.
            var result = await Queries.CloseIncidentsAsync(
                filter,
                expect is null && BulkActor.Length == 0 ? "console" : BulkActor,
                _bulkReason,
                expect,
                _cts?.Token ?? CancellationToken.None);

            if (result.Outcome != LifecycleOutcome.Applied)
            {
                _bulkError = result.Detail;
                _bulkCount = null;
            }
            else if (result.DryRun)
            {
                _bulkCount = result.Matched;
            }
            else
            {
                _bulkMessage = $"closed {result.Closed} incidents.";
                _bulkCount = null;
                _bulkReason = string.Empty;
                await LoadAsync();
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _bulkError = ex.Message;
            _bulkCount = null;
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    /// <summary>
    /// The fallback tick. Live updates arrive through <see cref="IIncidentNotifier"/> the
    /// moment the pipeline publishes one, but nothing publishes when an incident is merely
    /// getting older - and the duration column is the one a human is watching during an
    /// outage. This also keeps the page honest when a producer has not been wired up yet.
    /// </summary>
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();

        _viewer = await ConsoleViewer.ResolveAsync(AuthProvider, Authorization);

        await LoadAsync();

        var ct = _cts.Token;
        _namespaces = await SafeAsync(() => Queries.NamespacesAsync(ct), []);

        _ = TickAsync(_cts.Token);
        _ = ClockAsync(_cts.Token);
        _ = ListenAsync(_cts.Token);
    }

    /// <summary>
    /// Coalesced on purpose: a burst of ten step events during one investigation must
    /// produce one reload, not ten. The event says "something moved"; it never carries the
    /// data, so the page re-reads and lands on current truth whatever it missed.
    /// </summary>
    private async Task ListenAsync(CancellationToken ct)
    {
        try
        {
            await foreach (var _ in Notifier.SubscribeAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Advances the clock every second, and touches nothing else.
    /// </summary>
    /// <remarks>
    /// Split from <see cref="TickAsync"/> deliberately. Every elapsed time on this page is
    /// rendered against <c>_now</c>, so if the only thing that moves it is the ten-second
    /// data reload, ages advance in ten-second jumps and a running investigation looks
    /// frozen between them. This costs one re-render a second and no query at all, which is
    /// what makes it safe to run at this rate; reloading the list every second would not be.
    /// </remarks>
    private async Task ClockAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                _now = DateTimeOffset.UtcNow;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task TickAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadAsync()
    {
        var ct = _cts?.Token ?? CancellationToken.None;

        var query = new IncidentListQuery
        {
            State = Enum.TryParse<IncidentState>(_state, ignoreCase: true, out var s) ? s : null,
            OpenOnly = _state == "open",
            Kind = Enum.TryParse<SignalKind>(_kind, ignoreCase: true, out var k) ? k : null,
            Namespace = string.IsNullOrEmpty(_namespace) ? null : _namespace,
            // Kept in step with PAGE_LIMIT in scripts/e2e/ui/tests/console.spec.ts, which compares
            // this table's row count against the same API call - #49 was the two drifting apart.
            Limit = 200,
        };

        _incidents = await SafeAsync(() => Queries.ListAsync(query, ct), _incidents);
        _now = DateTimeOffset.UtcNow;
        _refreshedAt = _now;
        _loading = false;
    }

    /// <summary>
    /// Keeps the last good result on failure rather than blanking the table.
    /// </summary>
    /// <remarks>
    /// A console that empties itself when its database blips reads as "everything is fine",
    /// which is the single most dangerous thing this page could say. Stale data plus a
    /// visible error is honest; an empty table is not.
    /// </remarks>
    private async Task<T> SafeAsync<T>(Func<Task<T>> load, T fallback)
    {
        try
        {
            var result = await load();
            _error = null;
            return result;
        }
        catch (OperationCanceledException)
        {
            return fallback;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            return fallback;
        }
    }

    private async Task OnStateChanged(ChangeEventArgs e)
    {
        _state = e.Value?.ToString() ?? "open";
        ResetBulk();
        await LoadAsync();
    }

    private async Task OnKindChanged(ChangeEventArgs e)
    {
        _kind = e.Value?.ToString() ?? string.Empty;
        ResetBulk();
        await LoadAsync();
    }

    private async Task OnNamespaceChanged(ChangeEventArgs e)
    {
        _namespace = e.Value?.ToString() ?? string.Empty;
        ResetBulk();
        await LoadAsync();
    }

    private void Open(Guid id) => Nav.NavigateTo($"incidents/{id}");

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
