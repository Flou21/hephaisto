<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain class library with an ASP.NET framework reference, NOT an Aspire package.
       This dll IS deployed; Aspire.Hosting.* is not. Referencing any Aspire.Hosting
       package here would drag the dev-time orchestrator into the pod image. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- So BuildInfo.Parse can be tested directly. The version string comes from the build,
         which means the only way to test the parsing is to feed it strings by hand. -->
    <InternalsVisibleTo Include="Hephaisto.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core is safe to reference from anywhere: it has no I/O dependencies. Taken here
         only for the telemetry NAME constants, so a dashboard, an alert rule and the code
         emitting the metric cannot drift apart. -->
    <ProjectReference Include="../Hephaisto.Core/Hephaisto.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

</Project>
