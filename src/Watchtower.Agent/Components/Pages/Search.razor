@page "/search"
@inject IncidentQueries Queries
@implements IDisposable

<PageTitle>watchtower — search</PageTitle>

<h1>search incident history</h1>

<p class="wt-muted">
    Digests, not raw logs. Evidence blobs expire at 30 days while a digest is kept
    indefinitely, so this reaches back further than anything it was written from — and a
    digest has to stand on its own for exactly that reason.
</p>

<div class="wt-searchbar">
    <input type="search" placeholder="CrashLoopBackOff on payments-api after 1.24.3"
           @bind="_query" @bind:event="oninput" @onkeydown="OnKeyDown" autocomplete="off" />
    <label>
        <input type="checkbox" @bind="_resolvedOnly" />
        resolved only
    </label>
    <button type="button" @onclick="RunAsync" disabled="@_searching">search</button>
</div>

@if (!_semanticAvailable)
{
    @* Said out loud rather than hidden. A reader who does not know the vector arm is off
       will read a thin result set as "this never happened before". *@
    <p class="wt-note">
        <span class="glyph">i</span>
        Lexical arm only — no embedding generator is wired up yet, so paraphrases
        ("pods keep dying after the deploy") will not match. Exact identifiers still will,
        which is what most of these queries are actually made of.
    </p>
}

@if (_error is not null)
{
    <p class="wt-error"><span class="glyph">!!</span> @_error</p>
}

@if (_searching)
{
    <p class="wt-muted">searching…</p>
}
else if (_ran && _hits.Count == 0)
{
    <p class="wt-empty">Nothing matched. Only incidents that produced a digest are indexed.</p>
}
else if (_hits.Count > 0)
{
    <p class="wt-muted mono">@_hits.Count hits</p>

    <ol class="wt-hits">
        @foreach (var hit in _hits)
        {
            <li @key="hit.DigestId">
                <header>
                    <a href="incidents/@hit.IncidentId" class="wt-hit-target mono">
                        @hit.Namespace/@hit.WorkloadKey
                    </a>
                    <span class="wt-chip mono">@hit.Kind</span>
                    @if (hit.Resolved)
                    {
                        <span class="wt-yes"><span class="glyph">+</span> resolved</span>
                    }
                    else
                    {
                        <span class="wt-no"><span class="glyph">-</span> unresolved</span>
                    }
                    <span class="wt-muted mono">@Display.Timestamp(hit.CreatedAt)</span>
                </header>

                <p class="wt-digest">@hit.Digest</p>

                @* Why it matched, not just that it did. The fused score is a rank-fusion
                   number that is comparable inside this result set and meaningless outside
                   it, so the ranks are shown next to it - "the lexical arm put this third"
                   is a statement a human can actually check. *@
                <footer class="wt-why mono">
                    score @hit.Score.ToString("F4", CultureInfo.InvariantCulture)
                    ·
                    @if (hit.LexicalRank is { } lexical)
                    {
                        <span class="wt-chip chip-lexical" title="Rank in the full-text arm — matched literal terms">
                            lexical #@lexical
                        </span>
                    }
                    else
                    {
                        <span class="wt-muted">no lexical match</span>
                    }
                    @if (hit.SemanticRank is { } semantic)
                    {
                        <span class="wt-chip chip-semantic" title="Rank in the vector arm — matched meaning">
                            semantic #@semantic
                        </span>
                    }
                </footer>
            </li>
        }
    </ol>
}

@code {
    private string _query = string.Empty;
    private bool _resolvedOnly;
    private bool _searching;
    private bool _ran;
    private string? _error;
    private IReadOnlyList<IncidentSearchHit> _hits = [];

    private CancellationTokenSource? _cts;

    /// <summary>
    /// True once any hit comes back with a semantic rank. Inferred rather than configured:
    /// the search service decides per call whether the vector arm runs, and inferring keeps
    /// this page from claiming a capability that is only wired up in configuration.
    /// </summary>
    private bool _semanticAvailable;

    protected override void OnInitialized() => _cts = new CancellationTokenSource();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RunAsync();
        }
    }

    private async Task RunAsync()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            _hits = [];
            _ran = false;
            return;
        }

        _searching = true;
        _error = null;

        try
        {
            _hits = await Queries.SearchAsync(
                _query,
                new SearchFilter { ResolvedOnly = _resolvedOnly },
                limit: 25,
                _cts?.Token ?? CancellationToken.None);

            _semanticAvailable = _hits.Any(h => h.SemanticRank is not null);
            _ran = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _hits = [];
        }
        finally
        {
            _searching = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
