@*
    The root document. Static-rendered on purpose: it emits <html>, which cannot be part of
    an interactive component tree. Interactivity starts one level down, at <Routes/>.
*@
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Watchtower</title>
    @* Local stylesheet only. This pod may run in a cluster with no egress, and a console
       whose CSS silently fails to load is unreadable at exactly the moment it is needed. *@
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" href="data:," />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="app.js"></script>
</body>

</html>
