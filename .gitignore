bin/
obj/
.vs/
.idea/
*.user
.DS_Store
appsettings.Local.json
.env
*.received.*
TestResults/

# Local secret manifests. These carry real credentials in plaintext `stringData` so they can
# be edited by hand, which is exactly why they must never be committed. Ignored by directory
# AND by suffix, so a copy left anywhere in the tree is still caught.
secrets/
*.secret.yaml

# Never commit another system's state here. See docs/old-grafana-teardown.md.
backup/

# Per-machine Tilt settings: which resource groups are enabled, and the address the
# port-forwards bind to. Not tracked, because that address is specific to one machine's
# network. Copy tilt_config.sample.json to start; the Tiltfile defaults to localhost
# without it, so a fresh clone works with no config at all.
tilt_config.json

# Recorded eval scenarios and the reports built from them. Never committed: SafeToolDecorator
# redacts tool *arguments*, not tool *results*, so a cassette's raw describe_pod and
# get_pod_logs output carries cluster env vars, hostnames and log contents verbatim. They are
# reproducible with `hephaisto-eval record` against the dev cluster.
cassettes/
results/
